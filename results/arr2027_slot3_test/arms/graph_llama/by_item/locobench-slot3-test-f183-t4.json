  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The High-z Supernova Search Team published evidence in 1998 that distant Type Ia supernovae were fainter than expected.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Phillips relation links the decline rate of a Type Ia light curve to its peak luminosity.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Type Ia supernovae function as standardizable candles after correction for light-curve shape.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The dimming of the distant supernovae arises from accelerating cosmic expansion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The dimming of the distant supernovae arises in part from extinction by dust.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Ordinary interstellar dust reddens the light that it dims.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Both teams measured supernova colors to place limits on dust reddening along the line of sight.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Gray dust was proposed as a hypothetical absorber that would dim supernovae without reddening them.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Gray dust reddens supernova light more strongly than ordinary interstellar dust does.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Supernova 1997ff at redshift about 1.7 appeared brighter than gray-dust dimming models predicted.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Supernova 1997ff at redshift about 1.7 appeared fainter than any acceleration model allowed.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Observations of supernovae beyond redshift one revealed an earlier epoch of decelerating expansion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The 2011 Nobel Prize in Physics was awarded to Saul Perlmutter, Brian Schmidt, and Adam Riess.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "No Nobel Prize in Physics has been awarded for the discovery of cosmic acceleration.",
      "factual": true,
      "stance": "asserted"
    }
  ],
