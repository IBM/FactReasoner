      "id": "a0",
      "pos": 1,
      "text": "The school's reported proficiency rate rose from 35 percent to 78 percent in a single year.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The state education agency commissioned a forensic audit of the school's answer documents.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Researchers compare gains on the high-stakes test with gains on a low-stakes assessment given to the same students.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Difference-in-differences designs compare the school's score trajectory with that of similar schools that did not adopt the reform.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Genuine instructional reform tends to produce gains concentrated in the skills targeted by the new curriculum.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Erasure analysis measures the frequency of wrong-to-right answer changes on scanned answer sheets.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Erasure analysis identifies which specific individual altered each changed answer.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Brian Jacob and Steven Levitt built a detection algorithm that combines unusual answer-string patterns with unexpected score fluctuations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The Jacob and Levitt cheating detection method was developed using New York City public school data.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The school's wrong-to-right erasure rate exceeded the state average by more than three standard deviations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The new instructional program raised actual student achievement at the school.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Irregularities in test administration inflated the school's reported scores.",
      "factual": true,
      "stance": "asserted"
    },
