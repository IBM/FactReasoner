    {
      "id": "a2",
      "pos": 3,
      "text": "The Sycamore processor used in the 2019 experiment contained 127 superconducting qubits.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "IBM researchers argued that a tensor-network method exploiting secondary storage could perform the equivalent classical computation in about 2.5 days.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The classical baseline used in the original supremacy comparison was not the best algorithm available at the time.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The classical hardware model assumed in the original supremacy comparison underused available secondary storage.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "IBM's tensor-network rebuttal was published in Nature as a formal correction appended to Google's paper.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Google's 2019 quantum supremacy paper was retracted by the journal.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Google's 2019 quantum supremacy paper remains in the published literature without retraction.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Ewin Tang constructed a classical algorithm for recommendation systems that matched the polylogarithmic scaling of the quantum algorithm.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Dequantization results eliminated the claimed exponential speedup for several quantum machine learning algorithms.",
      "factual": true,
      "stance": "asserted"
    },
    {
