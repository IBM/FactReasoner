      "id": "a0",
      "pos": 1,
      "text": "Google reported that its Sycamore processor completed a random circuit sampling task in about 200 seconds.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Google's 2019 Nature paper estimated that a classical supercomputer would need roughly 10,000 years to reproduce the same sampling task.",
      "factual": true,
      "stance": "asserted"
