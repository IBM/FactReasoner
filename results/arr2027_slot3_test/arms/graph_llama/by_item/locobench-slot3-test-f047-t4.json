  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Phytophthora cinnamomi is a soilborne oomycete that causes root and collar rot in orchard trees.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Phytophthora cinnamomi is a true fungus classified in the phylum Ascomycota.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Pathologists excavate roots at the boundary between symptomatic and asymptomatic trees to inspect for lesions.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "A sharply defined cinnamon-brown lesion margin in the root cambium is characteristic of Phytophthora root rot.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Root asphyxiation produces diffuse, uniform root death without a discrete advancing lesion front.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Root asphyxiation is diagnosed by the presence of white mycelial fans beneath the bark at the root collar.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Symptomatic root tissue is plated onto a selective medium containing pimaricin, ampicillin, rifampicin and PCNB to recover Phytophthora.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A soil pit profile reveals compacted hardpan layers that restrict vertical drainage.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Soil redox potential measurements below about 300 millivolts indicate anaerobic conditions in the root zone.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The dieback pattern coincided with the low-lying, poorly drained portions of the block.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Symptomatic trees were concentrated in the depressions of the block where water accumulated.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Phytophthora was recovered from at least one of the sampled trees in the orchard.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "No isolate of any Phytophthora species was obtained from the sampled trees in the orchard.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The final diagnostic report concluded that the altered irrigation schedule, not a pathogen, initiated the decline.",
      "factual": true,
      "stance": "asserted"
    }
