  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Australian Energy Market Operator was responsible for investigating the 28 September 2016 South Australian system black event.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Investigators reconstructed the sequence of the event using time-synchronised data from phasor measurement units, fault recorders and SCADA logs.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Tornadoes damaged transmission towers on two 275 kV lines north of Adelaide.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Six voltage dips were recorded on the South Australian transmission network within about 87 seconds.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The wind turbine voltage ride-through settings limited the number of voltage disturbances the turbines would tolerate before reducing output.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Nine wind farms reduced their combined output by 456 MW during the voltage disturbances.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The Heywood interconnector tripped during the event.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Heywood interconnector remained in service throughout the event.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The rate of change of frequency after the interconnector separation exceeded 6 Hz per second.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The available under-frequency load shedding scheme could not operate quickly enough to arrest the frequency decline.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The market operator measured the rate of change of frequency at 0.5 Hz per second following separation.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The islanded system carried insufficient synchronous inertia to survive the loss of the interconnector.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "A sudden regional fall in wind speed reduced wind farm output immediately before the first transmission fault.",
      "factual": false,
      "stance": "asserted"
