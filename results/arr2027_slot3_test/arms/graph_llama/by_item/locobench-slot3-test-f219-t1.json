  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Sanduleak \u221269 202 was a red supergiant at the time of its explosion.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Underground detectors Kamiokande-II, IMB and Baksan recorded a burst of about two dozen neutrinos from the supernova.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The neutrino burst demonstrated that the stellar core collapsed into a hot proto-neutron star.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The detected neutrinos arrived over a span of roughly ten seconds.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The neutrino signal from the collapse lasted on the order of a dozen seconds.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Continued fallback accretion onto the proto-neutron star could have driven it over the maximum mass and produced a black hole.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "ALMA observations reported in 2019 revealed a compact hot dust blob offset from the explosion site.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Hubble Space Telescope imaging placed tight upper limits on the optical luminosity of any central compact object.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Hard X-ray spectra obtained with Chandra and NuSTAR are consistent with emission from a pulsar wind nebula embedded in the ejecta.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Cold dust condensing in the inner ejecta absorbs optical and ultraviolet radiation from the remnant's centre.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The ionization state of the central gas requires a persistent source of ultraviolet and X-ray photons.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The JWST detection of the central emission lines was made with the NIRCam imaging camera.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The compact object is enshrouded by a dense clump of dust and ejecta that blocks its direct light.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The thermal surface emission of the compact object is intrinsically faint.",
      "factual": true,
      "stance": "asserted"
    }
  ],
