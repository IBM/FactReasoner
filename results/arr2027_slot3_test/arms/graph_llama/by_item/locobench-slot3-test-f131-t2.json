  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Myopathies characteristically cause symmetric proximal limb weakness.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Peripheral neuropathies characteristically cause distal weakness accompanied by sensory loss.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Nerve conduction studies measure the amplitude, latency, and conduction velocity of signals travelling along peripheral nerves.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Markedly slowed nerve conduction velocity indicates demyelination of the peripheral nerve.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Reduced or absent deep tendon reflexes point toward a lesion of the peripheral nerve.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Sensory nerve action potentials are abolished in pure disorders of the muscle fiber.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Needle electromyography records the electrical activity of muscle fibers at rest and during voluntary contraction.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Myopathic disease produces short-duration, low-amplitude, polyphasic motor unit potentials on needle electromyography.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Neurogenic disease produces large-amplitude, long-duration motor unit potentials on needle electromyography.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Fibrillation potentials on needle electromyography occur only in myopathy and never in neurogenic disease.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The needle examination showed no fibrillation potentials in any sampled muscle.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Fibrillation potentials were present in at least one sampled muscle.",
      "factual": true,
      "stance": "asserted"
    },
