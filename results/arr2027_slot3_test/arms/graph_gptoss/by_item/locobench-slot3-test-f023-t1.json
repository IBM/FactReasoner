    {
      "id": "a8",
      "pos": 9,
      "text": "Needle electromyography showed short-duration, low-amplitude motor unit potentials.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The motor units sampled on needle electromyography generated brief, small electrical potentials.",
      "factual": true,
      "stance": "asserted"
    },
    {
