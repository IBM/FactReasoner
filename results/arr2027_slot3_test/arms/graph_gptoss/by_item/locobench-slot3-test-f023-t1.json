  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Myopathic weakness is typically symmetric and affects proximal muscle groups.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Deep tendon reflexes are lost early in the course of most primary myopathies.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Sensory loss accompanies many neurogenic causes of acute weakness.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Visible fasciculations point to a lower motor neuron disorder.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Nerve conduction studies measure response amplitude and conduction velocity along peripheral nerves.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Nerve conduction studies record the spontaneous electrical activity of individual resting muscle fibres.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Needle electromyography records motor unit action potentials from within the muscle.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Long-duration, high-amplitude polyphasic motor unit potentials indicate chronic denervation with reinnervation.",
      "factual": true,
      "stance": "asserted"
