  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Prevailing medical opinion in the 1970s attributed peptic ulcers to stress and excess gastric acid secretion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The stomach was widely believed to be too acidic for bacteria to colonize.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Robin Warren observed curved bacteria in gastric biopsy specimens at Royal Perth Hospital in 1979.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The bacterium was first successfully cultured in 1982 after culture plates were left to incubate for five days over an Easter holiday.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Warren and Marshall published letters in The Lancet in 1983 describing unidentified curved bacilli in the human stomach.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Helicobacter pylori produces urease and generates ammonia that buffers the surrounding acid.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Barry Marshall drank a broth culture of the bacterium in 1984 to test its ability to cause disease.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Marshall's self-experiment produced a bleeding duodenal ulcer documented by endoscopy.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Duodenal ulcers treated with acid suppression alone relapsed in most patients within a year of stopping the drug.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Randomized controlled trials showed that antibiotic eradication of the infection cut duodenal ulcer recurrence to a few percent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Eradicating the infection with a course of antibiotics cured ulcer disease and prevented relapse.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Clearing the bacterium with antimicrobial therapy produced lasting remission of peptic ulcers.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The Nobel Assembly at Karolinska Institutet determined that the 2005 prize in Physiology or Medicine be divided equally between Robin Warren and Barry Marshall.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Warren and Marshall received the Nobel Prize in Physiology or Medicine in 2001.",
      "factual": false,
      "stance": "denied"
    }
  ],
