    {
      "id": "a6",
      "pos": 7,
      "text": "Carbon monoxide and carbon dioxide in oil indicate degradation of cellulose paper insulation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Comparison of pre-failure DGA trend samples with post-failure samples distinguishes long-standing gassing from a single event.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Digital fault recorders capture time-stamped current and voltage waveforms at the substation terminals.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "GPS time synchronisation of SCADA logs and fault recorder records allows the event sequence to be ordered to the millisecond.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "A lightning strike was recorded within ten kilometres of the substation in the hour before the failure.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "No lightning strike was recorded within ten kilometres of the substation in the hour before the failure.",
      "factual": true,
      "stance": "asserted"
    },
