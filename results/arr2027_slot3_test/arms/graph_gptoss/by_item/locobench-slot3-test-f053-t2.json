    {
      "id": "a3",
      "pos": 4,
      "text": "The acetylene concentration in the oil sample reached 480 parts per million.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "IEEE C57.104 sets the condition-four action limit for dissolved acetylene at 500 parts per million.",
      "factual": false,
      "stance": "asserted"
