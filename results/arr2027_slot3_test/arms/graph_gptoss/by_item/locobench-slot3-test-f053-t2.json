      "pos": 1,
      "text": "Dissolved gas analysis measures fault gases dissolved in transformer insulating oil.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Acetylene in transformer oil indicates a high-energy arcing fault.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The Duval Triangle classifies fault type using the relative proportions of methane, ethylene and acetylene.",
      "factual": true,
      "stance": "asserted"
