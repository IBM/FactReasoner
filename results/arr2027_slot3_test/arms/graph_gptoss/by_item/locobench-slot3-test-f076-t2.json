  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Taphonomy is the study of the processes that affect remains between death and discovery.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Anthropologists compare the observed positions of skeletal elements against the expected anatomical arrangement of an intact body.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Retention of articulation at labile joints such as the hands and vertebrae indicates rapid burial of a fleshed body.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The skeletal elements retained their original anatomical relationships to one another.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The bones lay in articulated positions matching the layout of the body at death.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Fluvial transport sorts disarticulated skeletal elements according to their size and density.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Preferred orientation of long bones along a single axis is used as an indicator of water flow across a deposit.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Voorhies groups classify skeletal elements according to their susceptibility to carnivore chewing.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The remains were disturbed by natural processes after they were deposited.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The remains were already disarticulated at the moment of deposition.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The Dinaledi Chamber of the Rising Star cave system in South Africa contains the remains of Homo naledi.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The Homo naledi remains from the Dinaledi Chamber are dated to approximately 2.5 million years ago.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The Dinaledi Chamber deposits contain a pit feature cut into the underlying sediments.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The Dinaledi Chamber deposits contain no pit feature cut into the underlying sediments.",
      "factual": true,
      "stance": "asserted"
    }
  ],
