  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "J Harlen Bretz published his first papers on the Channeled Scabland in 1923.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Bretz's flood interpretation was accepted by the geological community immediately after his 1923 publications.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Bretz's critics attributed the scablands to slow erosion by ordinary rivers and glacial meltwater.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Bretz defended his flood hypothesis before the Geological Society of Washington in January 1927.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Pardee published evidence of giant current ripples on the floor of Glacial Lake Missoula in 1942.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Joseph Thomas Pardee identified Glacial Lake Missoula as the source of the floodwaters.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The Okanogan lobe of the ice sheet dammed the Clark Fork River to impound Glacial Lake Missoula.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Purcell Trench lobe of the Cordilleran ice sheet dammed the Clark Fork River.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Glacial Lake Missoula impounded roughly 2,000 cubic kilometers of water.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Peak flood discharge through the scablands is estimated at about 10 million cubic meters per second.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Erratic boulders stranded hundreds of feet above valley floors record the depth of the floodwaters.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Rhythmite layers in the Touchet beds of the Walla Walla valley record dozens of separate flood pulses.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Bretz's catastrophic flood hypothesis was vindicated.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The scientific community came to accept Bretz's flood origin for the Channeled Scablands.",
      "factual": true,
      "stance": "asserted"
    }
