    {
      "id": "a0",
      "pos": 1,
      "text": "Marija Gimbutas formulated the Kurgan hypothesis, placing the Proto-Indo-European homeland in the Pontic\u2013Caspian steppe.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Colin Renfrew's Anatolian hypothesis tied Indo-European dispersal to the spread of farming out of Anatolia around 7000 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Renfrew's Anatolian hypothesis located the homeland in the Balkans and dated the dispersal to 5000 BCE.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Reconstructed Proto-Indo-European contains an inherited term for wheel, *k\u02b7ek\u02b7los.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Archaeological evidence places the earliest wheeled vehicles no earlier than about 3500 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The wheeled-vehicle vocabulary implies that Proto-Indo-European was still a unified language after the mid-fourth millennium BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Radiocarbon dates place the earliest wagon burials in the sixth millennium BCE.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Anatolian branch lacks much of the wheeled-vehicle terminology reconstructed for the other branches.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Hittite is the earliest attested Indo-European language, recorded in cuneiform in the second millennium BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Gray and Atkinson's 2003 Bayesian phylogenetic analysis yielded a root age of roughly 8700 years before present.",
      "factual": true,
      "stance": "asserted"
    },
    {
