  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Alvarez team reported an anomalous enrichment of iridium in the Cretaceous-Paleogene boundary clay at Gubbio, Italy.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Iridium is scarce in Earth's crust and comparatively abundant in meteoritic material.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The iridium anomaly has been documented at more than 100 Cretaceous-Paleogene boundary sections worldwide.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The Alvarez iridium results were published in the journal Nature in 1980.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Shocked quartz grains are present in the Cretaceous-Paleogene boundary layer.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Glen Penfield and Antonio Camargo identified a buried circular structure beneath the Yucat\u00e1n Peninsula during petroleum surveys for Pemex.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Alan Hildebrand and colleagues published a 1991 paper linking the Chicxulub structure to the Cretaceous-Paleogene boundary.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Deccan Traps form a flood basalt province covering much of west-central India.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The shocked quartz at the boundary layer formed during explosive eruptions of the Deccan Traps.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Gerta Keller argued that Deccan Traps volcanism was the primary driver of the end-Cretaceous extinction.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The Chicxulub impact and the Cretaceous-Paleogene boundary are coeval within radiometric dating uncertainty.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The Chicxulub impact predates the Cretaceous-Paleogene boundary by roughly 300,000 years.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "IODP-ICDP Expedition 364 drilled into the Chicxulub peak ring in 2016.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The Expedition 364 drill core recovered shocked granite and suevite from the Chicxulub peak ring.",
      "factual": true,
      "stance": "asserted"
    }
