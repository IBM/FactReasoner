  "num_atoms": 14,
  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Urbain Le Verrier announced in 1859 that Mercury's perihelion advanced faster than Newtonian theory predicted.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Le Verrier's original estimate of the residual precession was 38 arcseconds per year.",
      "factual": false,
      "stance": "denied"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Le Verrier had successfully predicted the existence and position of Neptune in 1846 from anomalies in the motion of Uranus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Le Verrier proposed that an unseen intra-Mercurial planet or ring of matter caused Mercury's excess precession.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The hypothetical intra-Mercurial planet was given the name Vulcan.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Simon Newcomb refined the unexplained residual to 43 arcseconds per century in 1882.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Mercury's perihelion advances 43 arcseconds per century beyond the Newtonian prediction.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Astronomers searched for Vulcan during total solar eclipses and in transits across the solar disk.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Observers at the 1878 total solar eclipse obtained photographic plates that confirmed Vulcan's orbital period as 19 days.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Any mass sufficient to shift Mercury's perihelion by 43 arcseconds per century would have produced detectable perturbations in the orbit of Venus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "No intra-Mercurial planet of the mass required to explain the residual precession exists.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "A planet named Vulcan orbits the Sun inside the orbit of Mercury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Albert Einstein derived a perihelion advance of 43 arcseconds per century from his field equations in November 1915.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The physics community ultimately concluded that the perihelion residual arose from a deficiency in Newtonian gravitation rather than from an undiscovered planet.",
      "factual": true,
      "stance": "asserted"
    }
  ],
