      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A.J. Ayer argued that ethical sentences lack factual content and function as expressions of feeling.",
      "factual": true,
      "stance": "asserted"
