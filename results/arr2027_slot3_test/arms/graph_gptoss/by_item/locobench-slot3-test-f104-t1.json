  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Cognitivism holds that moral judgments express beliefs that are capable of being true or false.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Non-cognitivism holds that moral judgments express conative attitudes such as approval or disapproval rather than beliefs.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The Frege\u2013Geach problem presses non-cognitivists to explain how moral sentences retain a constant meaning when embedded in conditionals and arguments.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Simon Blackburn introduced quasi-realism to recover the realist-sounding features of moral discourse from expressivist premises.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Blackburn's quasi-realism abandons expressivist semantics in favour of mind-independent moral properties.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Moral judgments express beliefs about how things stand.",
      "factual": true,
