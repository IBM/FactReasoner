  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The 1998 evidence for cosmic acceleration came from two independent groups, the High-z Supernova Search Team and the Supernova Cosmology Project.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Adam Riess was the lead author of the 1998 High-z Supernova Search Team paper reporting acceleration.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Brian Schmidt led the High-z Supernova Search Team.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The High-z Supernova Search Team was led by Saul Perlmutter.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The distant supernovae appeared roughly 0.25 magnitudes fainter than expected in a universe containing only matter.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The observed colors of the high-redshift supernovae showed no significant reddening.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Ordinary interstellar dust reddens the light it transmits in addition to dimming it.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Anthony Aguirre proposed grey dust composed of large grains as a non-cosmological explanation for the dimming.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Dimming produced by intervening dust increases monotonically with the distance traveled by the light.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "SN 1997ff at a redshift near 1.7 was observed with the Hubble Space Telescope.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "SN 1997ff appeared brighter than a dust-only model predicted, indicating an earlier epoch of decelerating expansion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "SN 1997ff appeared fainter than grey dust models predicted.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Measurements of the cosmic microwave background indicated that the universe is spatially flat.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Galaxy cluster measurements placed the matter density at about 0.3 of the critical density.",
      "factual": true,
      "stance": "asserted"
    }
  ],
