      "pos": 1,
      "text": "Platform telemetry recorded machine check exceptions on several hosts in the cluster.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The failures persisted on hosts whose memory modules had been freshly replaced.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The ECC subsystem logged correctable single-bit errors on two hosts during the incident window.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Hardware faults typically cluster on individual machines rather than following a single code path.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "ECC memory silently corrects double-bit errors without recording any event.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "A subset of the cluster's memory modules produced uncorrectable errors.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The application accessed shared state without synchronization.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The corrupted responses carried checksums that did not match their payloads.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The suspect code path used a lock-free ring buffer shared between worker threads.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "A thread-sanitizer build reported a data race on the ring buffer's write index.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The remediation added a memory barrier around updates to the shared write index.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Hardware-induced faults reproduce deterministically on every execution of the same code path.",
      "factual": false,
      "stance": "asserted"
    },
