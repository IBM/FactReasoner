  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Girls and boys are socialized differently with respect to mathematical and technical competence.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Institutional gatekeeping in STEM hiring and evaluation disadvantages women candidates.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The Su, Rounds and Armstrong meta-analysis of vocational interest inventories reported a large gender difference in things-versus-people orientation, with an effect size of about d = 0.93.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The Su, Rounds and Armstrong meta-analysis reported a negligible gender difference of d = 0.08 in people-versus-things interests.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Hyde and colleagues analyzed state assessment data from more than seven million students and found no meaningful average gender difference in mathematics performance.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "A National Academies consensus report concluded that gender differences in mathematical ability do not account for women's underrepresentation in academic science.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Hyde's meta-analysis of mathematics achievement found that boys outperformed girls by half a standard deviation.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Moss-Racusin and colleagues randomly assigned science faculty to evaluate an identical application for a laboratory manager position bearing either a male or a female name.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Science faculty judged the applicant named John to be more competent than the applicant named Jennifer.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Competence ratings in the randomized laboratory manager study were higher for the male-named candidate than for the identically credentialed female-named candidate.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Faculty in the Moss-Racusin experiment offered a lower average starting salary to the applicant with the female name.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Stoet and Geary reported a gender-equality paradox in which countries with greater gender equality had smaller shares of women among STEM graduates.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Richardson and colleagues attempted to reproduce the gender-equality paradox and failed to replicate it.",
      "factual": true,
      "stance": "asserted"
    }
  ],
