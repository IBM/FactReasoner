    "domain": "Natural Sciences",
    "framing": "How did physicists establish whether the anomalous perihelion precession of Mercury reflected an undiscovered planet or a defect in Newtonian gravitation?",
    "split": "test",
    "word_count": 422,
    "generator": "claude-opus-5",
    "taxonomy": "v2",
