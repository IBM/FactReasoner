  "notes": null,
  "num_atoms": 14,
  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Urbain Le Verrier reported in 1859 that Mercury's perihelion advances faster than Newtonian theory predicts.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Le Verrier had predicted the position of Neptune in 1846 from anomalies in the orbit of Uranus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Le Verrier attributed Mercury's excess precession to an undiscovered planet orbiting inside Mercury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The hypothetical intramercurial planet was given the name Vulcan.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Astronomers mounted searches for Vulcan during total solar eclipses.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The objects reported by Watson and Swift during the 1878 total solar eclipse were later confirmed to be the planet Vulcan.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "A review of the nineteenth-century eclipse searches concluded that the reported Vulcan sightings were misidentifications of known stars.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A planet orbits the Sun inside the orbit of Mercury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "No planet orbits the Sun inside the orbit of Mercury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Newtonian perturbations from Venus, Earth, Jupiter, and Saturn account for about 530 arcseconds per century of Mercury's perihelion motion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Simon Newcomb recomputed the residual precession in 1882 and obtained a value near 43 arcseconds per century.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The precession of Mercury's perihelion left unaccounted for by Newtonian planetary perturbations amounts to 530 arcseconds per century.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Albert Einstein derived an advance of 43 arcseconds per century from the field equations of general relativity in November 1915.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Einstein's perihelion derivation contained no adjustable parameters fitted to Mercury's orbit.",
      "factual": true,
      "stance": "asserted"
    }
  ],
