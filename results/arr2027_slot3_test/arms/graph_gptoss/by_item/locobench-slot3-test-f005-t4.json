  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Hyatt Regency hotel walkway in Kansas City collapsed on July 17, 1981.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The collapse of the suspended walkways occurred in 1979 during a hotel construction phase.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The National Bureau of Standards conducted the technical investigation of the collapse.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The fourth-floor walkway was suspended from steel hanger rods bearing on welded box beams.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Failure began at the joint where the hanger rod passed through the box beam.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The hanger rods failed by tensile fracture at their mid-length.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The original design called for a single continuous hanger rod running from the roof framing through the fourth-floor walkway to the second-floor walkway.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The as-built arrangement used two offset rods in place of one continuous rod.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The two-rod arrangement doubled the load carried by the fourth-floor box beam connection.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The steel fabricator initiated the request to substitute the two-rod detail.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The engineer of record's firm affixed its review stamp to the shop drawings showing the two-rod detail.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Investigators performed laboratory load tests on replica box beam and hanger rod assemblies.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Investigators computed the ultimate capacity of the connection and compared it with the loads acting at the time of collapse.",
      "factual": true,
      "stance": "asserted"
