  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Flores hominin stood about one metre tall.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The stature of the Flores hominin was estimated at approximately 106 centimetres.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "LB1's endocranial volume was measured at approximately 417 cubic centimetres.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Teuku Jacob argued that LB1 was a modern human affected by microcephaly.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Eckhardt and Henneberg proposed in 2014 that LB1 exhibited the skeletal signature of Down syndrome.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Obendorf and colleagues proposed that the Liang Bua individuals suffered from myxoedematous endemic cretinism.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Later remeasurement revised LB1's endocranial volume upward to about 1,000 cubic centimetres.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Dean Falk generated a virtual endocast of the LB1 braincase from computed tomography scans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Falk's team compared the LB1 endocast with endocasts of microcephalic modern humans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Falk and colleagues concluded that the shape of the LB1 endocast fell outside the range of microcephalic modern humans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "A 2015 comparative study of the Liang Bua dentition determined that the teeth showed no signs of pathology and that the Down syndrome diagnosis was unsupported.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Mitochondrial DNA extracted from an LB1 molar fell within the range of modern human variation.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The LB1 skeleton possesses wrist bone morphology absent in modern human populations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The LB1 skeleton possesses shoulder and clavicle morphology absent in modern human populations.",
      "factual": true,
      "stance": "asserted"
