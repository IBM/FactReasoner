    {
      "id": "a4",
      "pos": 5,
      "text": "Disturbance of sediments by plants and animals is termed bioturbation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "A rodent burrow cut through the deposit containing the artifact.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "A later pit truncated the deposit containing the artifact.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Soil micromorphology uses thin sections to detect disruption of sediment fabric around a find.",
      "factual": true,
      "stance": "asserted"
