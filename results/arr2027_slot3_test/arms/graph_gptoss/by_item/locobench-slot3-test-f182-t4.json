      "id": "a0",
      "pos": 1,
      "text": "Stratigraphic excavation records the vertical sequence of deposits exposed at a site.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The law of superposition states that a lower deposit was laid down before the deposit resting above it.",
      "factual": true,
      "stance": "asserted"
