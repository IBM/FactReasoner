  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Late Bronze Age collapse in the Eastern Mediterranean is dated to roughly 1200\u20131150 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Mycenaean palace at Pylos was destroyed by fire around 1180 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Linear B administration in the Mycenaean palaces ended with the destructions around 1200 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The palatial record-keeping system of Mycenaean Greece ceased after the destruction of the palace centers.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Hattusa served as the capital of a continuous Hittite empire until the ninth century BCE.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The Hittite capital Hattusa was burned and abandoned in the early twelfth century BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Hittite letters request urgent shipments of grain from Ugarit.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A severe multi-decade drought affected the Eastern Mediterranean around 1200 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The maritime trade routes carrying copper and tin across the Eastern Mediterranean were disrupted around 1200 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Pollen cores from the Sea of Galilee record a shift to drier conditions in the late thirteenth century BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The aridification of the Eastern Mediterranean began after 1100 BCE and postdates the urban destruction layers.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Collapsed walls and skeletons buried under debris at Tiryns have been interpreted as earthquake damage.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Amos Nur proposed that a sequence of seismic events, termed an earthquake storm, struck the Aegean and Anatolia.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Eric Cline argued in his book 1177 B.C. that multiple interacting stressors produced the collapse.",
      "factual": true,
      "stance": "asserted"
    }
