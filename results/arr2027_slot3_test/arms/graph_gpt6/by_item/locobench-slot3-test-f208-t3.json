  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Sociologists use the term concentrated disadvantage to describe neighborhoods with overlapping poverty, joblessness, and family disruption.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Christopher Jencks and Susan Mayer's 1990 review argued that existing neighborhood studies could not separate contextual influence from residential sorting.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Robert Sampson's book Great American City documented the persistence of neighborhood inequality in Chicago across several decades.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Sibling-difference designs hold constant characteristics shared by children of the same parents.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The selection problem arises when unmeasured characteristics of residents determine which neighborhoods they live in.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Randomized housing mobility experiments are designed to break the link between family characteristics and neighborhood context.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Researchers use housing voucher lotteries as instrumental variables to identify neighborhood effects.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Moving to Opportunity demonstration was launched by the U.S. Department of Housing and Urban Development in 1994.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Moving to Opportunity assigned participating families to its treatment and control groups by lottery.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Moving to Opportunity relied entirely on observational comparisons of volunteer families with no random assignment.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Moving to Opportunity enrolled roughly 40,000 families across twenty American cities.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Children in Moving to Opportunity families who relocated after age eighteen showed the largest adult earnings gains.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The interim Moving to Opportunity evaluation documented improvements in adult mental health among movers.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The interim Moving to Opportunity evaluation detected no significant effects on adult employment or earnings.",
      "factual": true,
      "stance": "asserted"
    }
