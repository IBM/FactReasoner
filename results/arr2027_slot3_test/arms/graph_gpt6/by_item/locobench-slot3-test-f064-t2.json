  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Coleman Report concluded that neighborhood composition explained most of the variation in adult earnings.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Families residing in high-poverty neighborhoods differ from other families in unmeasured traits that bear on their children's later earnings.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Residence in a high-poverty neighborhood during childhood itself lowers a person's adult earnings.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Patrick Sharkey documented that more than 70 percent of Black families living in the poorest American neighborhoods remained in such neighborhoods a generation later.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The Gautreaux program relocated Chicago public housing residents to predominantly white suburban communities.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The interim Moving to Opportunity evaluation found no significant effects of relocation on adult employment or earnings.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Adults in the Moving to Opportunity experimental group reported better mental health and subjective well-being than controls.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Children who moved to low-poverty neighborhoods before age 13 earned about 31 percent more as young adults than their control-group counterparts.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The low-poverty voucher offer raised the adult earnings of children who relocated before their teens by roughly a third.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Chetty, Hendren, and Katz found that children who moved after age 13 experienced the largest earnings gains.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Raj Chetty and Nathaniel Hendren analyzed federal tax records covering more than five million families who moved between commuting zones.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Chetty and Hendren estimated that each additional year of childhood exposure to a better area produced a proportional gain in adult income.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Sibling comparison designs hold constant characteristics shared by children raised in the same family.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Random assignment of housing vouchers eliminates correlation between treatment status and unmeasured family characteristics.",
      "factual": true,
      "stance": "asserted"
    }
  ],
