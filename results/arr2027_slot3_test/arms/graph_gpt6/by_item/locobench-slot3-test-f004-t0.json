  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Raymond Dart described the Taung skull in the journal Nature in February 1925.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Taung fossil was discovered in a limestone quarry in Tanzania.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Dart's 1925 paper was titled \"Australopithecus africanus: The Man-Ape of South Africa\".",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Dart assigned the Taung specimen to the new species Australopithecus africanus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The Taung individual was a juvenile at the time of death.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The Taung individual died before reaching adulthood.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Arthur Keith argued that the Taung skull belonged to a juvenile anthropoid ape.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The canine teeth of the Taung individual were small and non-projecting.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The dental arcade of the Taung individual lacked the diastema seen in apes.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The forward position of the foramen magnum in the Taung skull indicated an upright posture.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Radiocarbon dating of the Taung cave deposits established an age of about 2.8 million years.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Robert Broom recovered adult australopithecine fossils at Sterkfontein beginning in 1936.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Wilfrid Le Gros Clark examined the South African australopithecine fossils in 1947.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The 1947 Pan-African Congress on Prehistory in Nairobi concluded that the australopithecines were hominids rather than apes.",
      "factual": true,
      "stance": "asserted"
    }
  ],
