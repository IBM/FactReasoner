      "id": "a0",
      "pos": 1,
      "text": "A state-wide blackout occurred in South Australia on 28 September 2016.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Tornadoes during the storm damaged 23 transmission towers in the state's mid-north.",
      "factual": true,
      "stance": "asserted"
