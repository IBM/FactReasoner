    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Approximately 456 MW of wind generation was lost within a few seconds.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The Heywood interconnector to Victoria tripped after being overloaded by increased imports.",
      "factual": true,
      "stance": "asserted"
