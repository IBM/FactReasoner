  "notes": null,
  "num_atoms": 14,
  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Tasaday were publicized in 1971 as a forest-dwelling group in South Cotabato province on the island of Mindanao.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Manuel Elizalde Jr. headed PANAMIN, the Philippine government agency charged with assistance to national minorities.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The Tasaday area was closed to outside visitors in 1976.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Swiss journalist Oswald Iten visited the Tasaday in 1986 shortly after Ferdinand Marcos was driven from power.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Elizalde presented the Tasaday to the world as cave dwellers who used stone tools and practiced no agriculture.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Iten reported finding Tasaday people living in wooden houses and wearing manufactured clothing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Iten published his allegation of a staged hoax in the Swiss newspaper Neue Z\u00fcrcher Zeitung.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The National Geographic Society formally retracted its 1972 Tasaday article in 1987.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Linguist Lawrence Reid carried out fieldwork showing that Tasaday speech is closely related to Cotabato Manobo.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Reid estimated that the Tasaday had separated from their Manobo-speaking relatives roughly 150 years before their 1971 publicization.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Historian Zeus Salazar argued that the Tasaday were a fabrication staged for the political benefit of the Marcos government.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Genealogical research by Emmanuel Nabayra and Amelia Rogel-Rara traced kinship ties between the Tasaday and neighboring communities.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Radiocarbon dating of charcoal from the Tasaday caves established continuous human occupation for 3,000 years.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The 1992 scholarly volume assessing the evidence determined that the Tasaday were neither a Stone Age survival nor a hoax.",
      "factual": true,
      "stance": "asserted"
    }
  ],
