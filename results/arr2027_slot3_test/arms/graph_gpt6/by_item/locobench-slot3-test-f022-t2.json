    {
      "id": "a0",
      "pos": 1,
      "text": "Radiocarbon dating of destruction layers supplies a chronology independent of the textual record.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Late Bronze Age collapse unfolded across the eastern Mediterranean between roughly 1200 and 1150 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Dendrochronological sequences fix the onset of the collapse precisely to the year 1177 BCE.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "A chronological review panel ultimately determined that 1177 BCE is a symbolic marker derived from Egyptian records rather than a tree-ring-fixed date.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Inscriptions at Medinet Habu record Ramesses III's battles against a coalition known as the Sea Peoples.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The Medinet Habu reliefs date the great naval battle against the Sea Peoples to the eighth year of Merneptah.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Cuneiform tablets from Ugarit describe hostile ships appearing off the Syrian coast.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The surviving cuneiform archives preserve the perspectives of palace elites rather than rural populations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The Hittite capital Hattusa ceased to function as an imperial centre around 1200 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The Hittite empire ceased to exist as a political entity in the early twelfth century BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Hittite imperial rule came to an end during the first decades of the 1100s BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Pollen cores from the Sea of Galilee indicate a period of reduced rainfall between about 1250 and 1100 BCE.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Egyptian records document shipments of grain sent to the land of Hatti during a famine.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Eric Cline attributes the collapse to a systems failure involving multiple interlocking causes.",
