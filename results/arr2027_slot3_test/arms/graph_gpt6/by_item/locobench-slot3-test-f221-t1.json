  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Forensic engineers recover, tag, and catalogue the fracture surfaces of every failed member from the collapsed span.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Fractographic examination distinguishes progressive fatigue cracking from single-event overload fracture.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Section loss from corrosion is measured on the recovered steel plates and chords.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The original design calculations are recomputed against the loads actually present at the moment of collapse.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Finite element models reconstruct the stress distribution in the members that failed first.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Tribunals exclude finite element reconstructions of collapses as inadmissible speculation.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The owner's periodic inspection reports document the recorded condition of the structure before the collapse.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The owner never carried out the repainting of the corroded members recommended by its inspectors.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The gusset plates were undersized relative to the forces they were required to carry.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Corrosion had thinned the gusset plates before the day of the collapse.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The collapse caused no fatalities.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Thirteen people died in the collapse.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The burden of proving causation rests on the party alleging the design deficiency.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "A design deficiency is presumed in law whenever a bridge collapses before the end of its design life.",
      "factual": false,
      "stance": "asserted"
    }
