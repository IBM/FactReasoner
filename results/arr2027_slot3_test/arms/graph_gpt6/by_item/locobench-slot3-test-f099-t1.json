  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The latency between the first dose of the medication and the onset of jaundice was six weeks.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Jaundice appeared about a month and a half after the patient took the first dose of the medication.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The Roussel Uclaf Causality Assessment Method awards points for latency, the course of enzymes after drug withdrawal, concomitant drug use, exclusion of competing causes, and prior published reports of hepatotoxicity for the agent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The Roussel Uclaf Causality Assessment Method is a structured scoring instrument used to grade the likelihood that a drug caused a liver injury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "A Roussel Uclaf Causality Assessment Method score of 3 to 5 indicates highly probable drug causality.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "An elevated serum IgG concentration supports a diagnosis of autoimmune hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Nitrofurantoin and minocycline are recognised causes of drug-induced autoimmune-like hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Antinuclear antibodies are absent in all patients with drug-induced liver injury.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Liver biopsy in autoimmune hepatitis typically shows interface hepatitis with a plasma cell-rich portal infiltrate.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Prominent eosinophilic infiltration and zonal hepatocellular necrosis on biopsy favour a drug-induced aetiology.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Biochemical improvement after stopping the suspect medication constitutes a positive dechallenge supporting drug causality.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Corticosteroid therapy can produce biochemical remission in both drug-induced liver injury with autoimmune features and idiopathic autoimmune hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The newly started medication caused the patient's liver injury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The patient had underlying idiopathic autoimmune hepatitis.",
      "factual": true,
      "stance": "asserted"
    }
