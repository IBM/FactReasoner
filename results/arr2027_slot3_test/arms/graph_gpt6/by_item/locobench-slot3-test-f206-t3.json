  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The comparative method establishes genetic relationship through systematic sound correspondences across the lexicons of two languages.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Antoine Meillet treated shared morphological irregularities as the strongest evidence of common descent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Basic vocabulary such as body-part terms, kinship terms and low numerals is more resistant to borrowing than cultural vocabulary.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Numerals are never borrowed between languages.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Loanwords frequently violate the regular sound laws of the recipient language.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Loanwords can be dated relative to the sound changes they underwent or escaped.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Structural features such as vowel harmony and verb-final word order spread readily through language contact.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Hungarian is a member of the Turkic language family.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Hungarian shares inherited basic vocabulary and verbal morphology with Khanty and Mansi.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Hungarian belongs to the Uralic language family.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Every Turkic-looking word in Hungarian entered the language through borrowing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "At least one Turkic\u2013Hungarian lexical resemblance is an inheritance from a common ancestor.",
      "factual": true,
      "stance": "asserted"
    },
