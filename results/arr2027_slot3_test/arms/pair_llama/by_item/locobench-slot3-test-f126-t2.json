  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Differential socialization of girls and boys contributes to the gender gap in STEM participation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Differences in occupational preferences between women and men contribute to the gender gap in STEM participation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Spencer, Steele, and Quinn found that framing a difficult math test as diagnostic of ability depressed women's performance relative to men's.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The greater male variability hypothesis predicts a higher ratio of males to females at the extreme upper tail of the mathematics ability distribution.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The greater male variability hypothesis predicts equal numbers of men and women in the top one percent of mathematics performance.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Stoet and Geary reported that countries ranking higher on gender-equality indices had lower shares of women among STEM graduates.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Guiso and colleagues found that cross-country measures of gender equality were associated with smaller gender gaps in PISA mathematics scores.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Nosek and colleagues found that nation-level implicit stereotypes linking science with males predicted national sex differences in eighth-grade science achievement.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Cross-national variation in the size of the STEM gender gap is cited as evidence that social environments shape participation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Guiso and colleagues reported that the mathematics gender gap was of identical magnitude in every country they examined.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Moss-Racusin and colleagues found that science faculty rated identical application materials bearing a male name as more competent than those bearing a female name.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Ceci and Williams argued that occupational preferences rather than hiring discrimination account for women's scarcity in math-intensive academic fields.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Women earn the majority of bachelor's degrees awarded in the biological sciences in the United States.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Women earn fewer than half of all bachelor's degrees awarded in the biological sciences in the United States.",
      "factual": true,
      "stance": "asserted"
    }
  ],
