  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "J Harlen Bretz was a University of Chicago geologist who mapped the Channeled Scablands during the 1920s.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Bretz presented his flood hypothesis to a hostile audience at a January 1927 meeting of the Geological Society of Washington.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Bretz attributed the floodwater to meltwater released by a volcanic eruption beneath the Cordilleran Ice Sheet.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Bretz's critics argued that the scablands were cut by ordinary river erosion acting over millions of years.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The Purcell Trench lobe of the Cordilleran Ice Sheet dammed the Clark Fork River to impound Glacial Lake Missoula.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Joseph Thomas Pardee identified Glacial Lake Missoula in western Montana as the source of the floodwater.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Giant current ripples up to about 15 metres high occur on the floor of the Camas Prairie basin in Montana.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Pardee published \"Unusual Currents in Glacial Lake Missoula, Montana\" in 1942.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Peak flood discharge through the scablands has been estimated at roughly 17 million cubic metres per second.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Dry Falls in the Grand Coulee is an abandoned cataract roughly 5.6 kilometres wide with a drop of about 120 metres.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Ice-rafted granitic erratics rest hundreds of metres above the floors of scabland valleys.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The scabland channels are carved into granite of the Idaho Batholith.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The Channeled Scablands record only a single flood event.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The Channeled Scablands record more than one flood event.",
      "factual": true,
      "stance": "asserted"
    }
  ],
