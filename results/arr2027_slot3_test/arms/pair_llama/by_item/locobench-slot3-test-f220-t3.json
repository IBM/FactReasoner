  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Excavations at Liang Bua in 2003 recovered the partial skeleton designated LB1.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Liang Bua yielded hominin skeletal remains belonging to multiple individuals.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "LB1 is the only hominin individual recovered from Liang Bua.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Researchers named the new species Homo floresiensis in a 2004 paper in Nature.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "LB1's endocranial volume is approximately 400 cubic centimetres.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Critics proposed that LB1 was a modern human affected by microcephaly.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Dean Falk's team produced a virtual endocast of LB1 from computed tomography scans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The endocast comparison showed that LB1's brain shape differed from that of microcephalic modern humans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "LB1's endocranial volume was measured at about 1,100 cubic centimetres.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Maciej Henneberg and colleagues argued that LB1 had Down syndrome.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "A 2017 review of the pathology arguments concluded that the Down syndrome diagnosis for LB1 was inconsistent with the fossil's measurements.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The LB1 skeleton displays the diagnostic bone changes of endemic cretinism.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Matthew Tocheri's analysis found that LB1's wrist bones retained primitive, ape-like morphology.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The phylogenetic analysis by Argue and colleagues placed Homo floresiensis outside Homo sapiens.",
      "factual": true,
      "stance": "asserted"
    }
  ],
