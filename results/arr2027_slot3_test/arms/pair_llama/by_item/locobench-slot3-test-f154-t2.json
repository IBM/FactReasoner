  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Diffusion accounts explain a shared trait as transmission from one society to another through contact.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Independent invention accounts explain a shared trait as separate origination in each society.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Franz Boas founded the Kulturkreis school of extreme diffusionism.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Francis Galton raised the problem of cultural non-independence in response to a cross-cultural paper by Edward Burnett Tylor.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Galton's problem was first identified by cross-cultural statisticians in the 1970s.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Statistical tests that treat societies as independent data points overstate the significance of cross-cultural correlations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Treating cultures as independent samples inflates the apparent strength of observed cross-cultural associations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Shared ecological constraints can produce the same innovation in unconnected societies.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Arbitrary shared details carry more evidential weight for contact than functionally constrained similarities.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Loanwords for a practice in the receiving language are treated as evidence of borrowing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Ancient DNA analysis can detect gene flow between two populations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Demonstrating a plausible route of contact between the two societies strengthens the diffusion hypothesis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The sweet potato was carried to Polynesia by human voyagers.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The sweet potato reached Polynesia by natural dispersal of its seeds.",
      "factual": true,
      "stance": "asserted"
    }
