    {
      "id": "a0",
      "pos": 1,
      "text": "Researchers compare a school's score gains to gains at demographically similar schools in the same district.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "A single-year score gain larger than one standard deviation is statistically impossible without cheating.",
      "factual": false,
      "stance": "denied"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Erasure analysis examines patterns of wrong-to-right answer changes on scanned answer sheets.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Unusually high rates of wrong-to-right erasures in a classroom are treated as a marker of possible answer tampering.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Investigators compare performance on the high-stakes state test with performance on a low-stakes audit test such as the National Assessment of Educational Progress.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The National Assessment of Educational Progress is administered to every student in each tested grade.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "At least one classroom at the school showed erasure rates above the statewide flagging threshold.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "No answer sheets from the school showed erasure rates above the statewide flagging threshold.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Students' answer sheets were altered after the testing session ended.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Students received improper assistance from adults during the testing session.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Genuine instructional improvement generally persists in the following year's test results.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
