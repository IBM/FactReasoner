    {
      "id": "a0",
      "pos": 1,
      "text": "Idiosyncratic drug-induced liver injury typically begins between 5 and 90 days after the medication is started.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The R value is calculated as serum ALT expressed in multiples of its upper limit of normal divided by alkaline phosphatase expressed in multiples of its upper limit of normal.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The R ratio is obtained by dividing the fold-elevation of ALT above normal by the fold-elevation of alkaline phosphatase above normal.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "An R value below 2 defines a hepatocellular pattern of liver injury.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The RUCAM scale assigns points for latency, the course after drug withdrawal, risk factors, concomitant drugs, exclusion of alternative causes, and prior reports of hepatotoxicity for the agent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "A RUCAM score of 2 or less indicates highly probable drug-induced liver injury.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Antinuclear antibody, anti-smooth muscle antibody, and anti-liver-kidney microsomal type 1 antibody testing supports a diagnosis of autoimmune hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Anti-mitochondrial antibody positivity is the defining serologic marker of autoimmune hepatitis.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "An elevated serum immunoglobulin G level is a characteristic laboratory feature of autoimmune hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The International Autoimmune Hepatitis Group simplified score incorporates autoantibody titres, IgG level, liver histology, and absence of viral hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
