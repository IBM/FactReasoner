      "pos": 11,
      "text": "The old-wood effect can make a charcoal date older than the event that deposited it.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Short-lived single-entity samples such as carbonised seeds reduce the risk of dating residual material.",
      "factual": true,
      "stance": "asserted"
    },
