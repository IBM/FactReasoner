    {
      "id": "a3",
      "pos": 4,
      "text": "Conventional radiocarbon ages are reported as years before 1900 CE.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Raw radiocarbon measurements must be calibrated against a tree-ring-derived calibration curve.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Marine shell samples require a reservoir age correction before calibration.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "IntCal20 is the calibration curve used for Northern Hemisphere terrestrial samples.",
      "factual": true,
      "stance": "asserted"
