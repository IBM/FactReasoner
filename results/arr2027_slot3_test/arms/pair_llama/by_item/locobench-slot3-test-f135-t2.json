  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The patient developed jaundice three weeks after starting amoxicillin-clavulanate.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Serum alanine aminotransferase was elevated to more than five times the upper limit of normal.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The R value is calculated by dividing the alanine aminotransferase level by the alkaline phosphatase level, each expressed as a multiple of its upper limit of normal.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "An R value greater than 5 defines a hepatocellular pattern of liver injury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The jaundice arose from direct injury to hepatocytes.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The jaundice arose from impaired bile flow within the liver.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Clinicians tested for hepatitis A IgM, hepatitis B surface antigen, and hepatitis C RNA.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A positive hepatitis C IgG antibody result confirms acute hepatitis C infection.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Hepatitis E serology is recommended in the workup of suspected drug-induced liver injury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Antinuclear antibody and anti-smooth muscle antibody positivity supports a diagnosis of autoimmune hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "A consulting hepatologist attributed the liver injury to underlying autoimmune hepatitis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "A normal antinuclear antibody titre excludes autoimmune hepatitis.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The treating physician attributed the jaundice to the newly started antibiotic.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The RUCAM scale assigns points for latency, the course of enzyme levels after drug withdrawal, risk factors, and exclusion of competing causes.",
      "factual": true,
      "stance": "asserted"
    }
