  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Lincoln Elementary's fifth-grade math proficiency rate rose from 38 percent to 81 percent in a single year.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The state testing agency flagged the school's one-year score gain as a statistical outlier.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The state released anonymized answer-sheet and item-response data to the research team.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Erasure analysis measures the rate of wrong-to-right answer changes on scanned answer sheets.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Lincoln Elementary's wrong-to-right erasure rate exceeded the state mean by more than five standard deviations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Right-to-wrong erasures outnumber wrong-to-right erasures on legitimately completed answer sheets.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Erasure analysis identifies with certainty which individual student altered each answer.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Item-level response patterns showed implausibly high accuracy on the most difficult test items.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Investigators interviewed teachers and proctors who were present during the test administration.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Four teachers reported that completed answer sheets were stored unsealed overnight in a school office.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Proctors supplied correct answers to students during the test session.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "School staff altered student answer sheets after the test session ended.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The state invalidated at least some of Lincoln Elementary's fifth-grade test scores.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "No test scores at Lincoln Elementary were invalidated.",
      "factual": true,
      "stance": "asserted"
    }
