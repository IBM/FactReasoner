  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The comparative method establishes common descent by demonstrating systematic sound correspondences between languages.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Regular sound correspondences recurring across many lexical items are the primary evidence linguists accept for genetic relationship.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Core vocabulary such as body parts, kinship terms, and low numerals is relatively resistant to borrowing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Basic vocabulary including pronouns and numerals is never borrowed in any documented language.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "A word borrowed after a sound change has ceased to operate does not display the effects of that change.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "A loanword that postdates a sound law fails to exhibit the reflex that the law produced.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "A borrowed word frequently retains a phonological shape that violates the receiving language's historical sound laws.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Linguists test a shared item by reconstructing a proto-language form and checking whether both languages' forms follow from it by known sound laws.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The term Sprachbund designates a set of geographically contiguous languages that share structural features without descending from a recent common ancestor.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Albanian, Romanian, and Bulgarian each belong to a different branch of Indo-European.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Albanian, Romanian, and Bulgarian all place the definite article after the noun.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The languages of the Balkan Sprachbund all descend from a single Indo-European branch called Paleo-Balkan.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Documented historical bilingualism between two speech communities supports a contact explanation for a shared feature.",
      "factual": true,
      "stance": "asserted"
    }
