  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The RAPID-MOCHA array began continuous monitoring of Atlantic overturning at 26.5\u00b0N in April 2004.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Florida Current transport has been measured with a submarine telephone cable since 1982.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The RAPID array was deployed across 41\u00b0N in 1992.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Overturning transport at 26.5\u00b0N fell by roughly 30% during the winter of 2009-2010.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The 2009-2010 downturn was the largest transport anomaly in the array record at the time of its observation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Smeed and colleagues reported an average decline of about 0.5 Sverdrups per year between 2004 and 2012.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Ocean reanalyses placed the 2000s decline within the spread of internally generated variability simulated by climate models.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The ten-year RAPID record was too short to distinguish a forced trend from natural variability.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "A decade of array measurements could not separate anthropogenic weakening from internal fluctuations.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Model experiments showed that a single decade of monitoring is sufficient to detect an anthropogenic overturning trend.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Detection studies using climate models estimated that several decades of continuous observations are needed to identify a forced overturning trend.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "A review of the RAPID observations determined that the 2009-2010 downturn reflected short-term variability rather than a long-term weakening trend.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Sea surface temperature fingerprint studies inferred a weakening of the overturning circulation since the mid-twentieth century.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Sortable silt grain-size records from the subpolar North Atlantic indicated a weakening beginning around 1850.",
      "factual": true,
      "stance": "asserted"
    }
  ],
