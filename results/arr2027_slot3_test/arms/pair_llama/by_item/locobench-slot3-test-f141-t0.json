  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The RAPID-MOCHA array has continuously monitored AMOC transport at 26.5\u00b0N since 2004.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The RAPID monitoring array was deployed along 41\u00b0N in 1992.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The RAPID array recorded a weakening of about 2.7 Sverdrups in AMOC strength between 2004 and 2012.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Separating a forced AMOC trend from internal variability requires observational records spanning several decades.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The AMOC decline observed by RAPID between 2004 and 2012 was statistically distinguishable from internal variability.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The AMOC decline observed by RAPID between 2004 and 2012 was not statistically distinguishable from internal variability.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Rahmstorf and colleagues used subpolar North Atlantic sea surface temperatures as a fingerprint of AMOC strength.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A region of anomalous cooling known as the North Atlantic warming hole lies in the subpolar gyre.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Caesar and colleagues estimated that the AMOC has weakened by about 60 percent since 1950.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The Greenland Ice Sheet lost mass at an average rate of roughly 270 gigatonnes per year between 2002 and 2020.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Freshwater input lowers surface density and suppresses deep convection in the Labrador and Irminger Seas.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Anthropogenic freshwater input from Greenland has reduced surface density in the subpolar North Atlantic.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Natural multidecadal variability has contributed to AMOC fluctuations observed since 2004.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "A review of the RAPID observational record determined that the 2004\u20132012 weakening largely reflected internal variability rather than a forced long-term trend.",
      "factual": true,
      "stance": "asserted"
    }
  ],
