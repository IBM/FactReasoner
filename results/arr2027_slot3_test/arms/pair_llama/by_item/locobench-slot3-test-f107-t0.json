  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The neutrinos studied by OPERA were produced in the CNGS beam at CERN.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The flight path between the CERN source and the OPERA detector spanned about 730 kilometres.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The CERN-to-Gran Sasso baseline used in the OPERA measurement was 450 kilometres long.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "OPERA reported in September 2011 that neutrinos arrived roughly 60 nanoseconds earlier than light would have.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "OPERA released its measurement as an arXiv preprint and invited independent scrutiny instead of claiming a discovery.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Andrew Cohen and Sheldon Glashow argued that superluminal neutrinos would lose energy by emitting electron-positron pairs in flight.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The ICARUS experiment observed no sign of the in-flight energy loss predicted by Cohen and Glashow.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The OPERA timing chain depended on GPS satellite synchronisation between CERN and Gran Sasso.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The baseline distance was fixed by geodetic surveying to an accuracy of about 20 centimetres.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The OPERA anomaly was traced to an error in the geodetic survey of the baseline distance.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "OPERA disclosed two faults in its timing equipment in February 2012.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "ICARUS reported in March 2012 a neutrino time-of-flight consistent with light propagation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The OPERA, ICARUS, LVD and Borexino experiments all reported neutrino velocities compatible with the speed of light.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The neutrinos traversed the baseline in the same time that light would have taken.",
      "factual": true,
      "stance": "asserted"
    }
  ],
