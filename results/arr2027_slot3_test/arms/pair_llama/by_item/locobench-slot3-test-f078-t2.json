      "text": "Connoisseurship compares a disputed picture's brushwork and handling with the artist's documented works.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Provenance research traces a painting's chain of ownership back toward the artist's studio.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Infrared reflectography reveals underdrawing beneath the paint surface.",
      "factual": true,
      "stance": "asserted"
