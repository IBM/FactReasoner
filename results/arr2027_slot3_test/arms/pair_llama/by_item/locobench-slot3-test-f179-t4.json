  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Urbain Le Verrier reported in 1859 that Mercury's perihelion advanced faster than Newtonian theory predicted.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Mercury's perihelion advances by about 43 arcseconds per century beyond the Newtonian prediction.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The unexplained residual in Mercury's apsidal motion amounts to roughly 43 arcseconds each century.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Le Verrier had successfully predicted the position of Neptune from irregularities in the orbit of Uranus in 1846.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Le Verrier attributed the Mercury residual to an undiscovered planet orbiting inside Mercury's orbit.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Newtonian gravitation is an incomplete description of the Sun's gravitational field.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "An undetected mass inside Mercury's orbit perturbs the planet's motion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "James Craig Watson reported sighting intra-Mercurial objects during the total solar eclipse of 1878.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Watson's 1878 eclipse object was recovered photographically at the next opposition and entered into the planetary catalogues.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Simon Newcomb recomputed the residual precession of Mercury in 1882.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Mercury's anomalous perihelion advance amounts to 43 arcseconds per year.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Einstein derived the residual precession from his field equations in a paper presented in November 1915.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Einstein's derivation of the precession contained no adjustable parameters fitted to the Mercury data.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "No planet has ever been confirmed to orbit inside the orbit of Mercury.",
      "factual": true,
      "stance": "asserted"
    }
  ],
