    {
      "id": "a2",
      "pos": 3,
      "text": "Distant Type Ia supernovae near redshift 0.5 appeared about 0.25 magnitudes fainter than expected in a universe without dark energy.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The High-z Supernova Search Team announced evidence for an accelerating universe in 1998.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The grey dust hypothesis posited dust grains large enough to dim light without reddening it.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Part of the observed dimming of distant supernovae is caused by intervening dust.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Part of the observed dimming of distant supernovae is caused by accelerated cosmic expansion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Astronomers observed the supernova SN 1997ff with the Hubble Space Telescope.",
      "factual": true,
      "stance": "asserted"
