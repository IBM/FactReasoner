  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Type Ia supernovae were used as standardizable candles for measuring cosmological distances.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Type Ia supernovae arise from the core collapse of massive stars.",
      "factual": false,
      "stance": "asserted"
