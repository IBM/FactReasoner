      "pos": 9,
      "text": "SN 1997ff was measured at a redshift of 0.5.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "SN 1997ff appeared brighter than grey dust models predicted.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Adam Riess reported in 2001 that SN 1997ff provided evidence of an earlier decelerating phase of cosmic expansion.",
      "factual": true,
      "stance": "asserted"
