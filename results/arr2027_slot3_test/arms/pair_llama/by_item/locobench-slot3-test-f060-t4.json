      "pos": 8,
      "text": "A hidden-moderator explanation becomes testable when the proposed moderator is directly manipulated in a new experiment.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Registered Replication Reports coordinate a common preregistered protocol across multiple independent laboratories.",
      "factual": true,
      "stance": "asserted"
