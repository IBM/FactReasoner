    "canonical_topic": "Anthropology",
    "domain": "Social Sciences",
    "framing": "How did anthropologists adjudicate the dispute over whether the Tasaday of Mindanao were a genuinely isolated Stone Age people or a staged fabrication, and what evidence ultimately settled the matter?",
    "split": "test",
    "word_count": 477,
    "generator": "claude-opus-5",
    "taxonomy": "v2",
