  "num_atoms": 14,
  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Tasaday were presented to the world in 1971 as a previously uncontacted forest-dwelling group in South Cotabato, Mindanao.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Manuel Elizalde Jr. headed PANAMIN, the body that controlled outside access to the Tasaday.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "A T'boli hunter and trapper named Dafal made the first reported contacts with the Tasaday in the late 1960s.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The Tasaday numbered about 250 people when they were first brought to public attention.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Access to the Tasaday area was closed to outside researchers in 1976.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "A 1986 ABC television documentary titled \"The Tribe That Never Was\" alleged that the Tasaday were a fabrication.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Swiss journalist Oswald Iten reached the Tasaday caves in 1986 after the fall of the Marcos government.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Tasaday were wearing manufactured shirts and trousers when Iten arrived at the caves in 1986.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Thomas Headland organized a symposium on the Tasaday controversy at the 1989 International Congress of Anthropological and Ethnological Sciences in Zagreb.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Headland edited the volume \"The Tasaday Controversy: Assessing the Evidence,\" published by the American Anthropological Association in 1992.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Linguist Lawrence Reid conducted fieldwork on the speech variety used by the Tasaday.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The Tasaday had never encountered people from outside their forest before 1971.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The Tasaday had contact with neighboring lowland and upland groups before 1971.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Lawrence Reid concluded that the Tasaday speech variety was unrelated to any Manobo language.",
      "factual": false,
      "stance": "asserted"
    }
  ],
