  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Regular sound correspondences between two languages are the standard evidence for genetic relationship.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The comparative method requires reconstruction of a proto-language from attested daughter languages.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Mass lexical comparison without reconstruction is rejected by most historical linguists.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Shared irregular morphology is treated as among the strongest evidence of common descent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Shared basic word order is accepted by historical linguists as proof of genetic relationship.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Typological traits such as tone and monosyllabicity can spread between unrelated neighbouring languages.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Loanwords cluster in semantic fields tied to trade, religion, and technology.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Shared basic vocabulary such as body-part and kinship terms is relatively resistant to borrowing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Numerals are never borrowed between languages in contact.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Henri Maspero classified Vietnamese as a Tai language in 1912.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Some of the lexical resemblances between Vietnamese and Tai languages are the product of borrowing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Some of the lexical resemblances between Vietnamese and Tai languages are the product of accidental similarity.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Vietnamese is a member of the Austroasiatic family.",
      "factual": true,
      "stance": "asserted"
