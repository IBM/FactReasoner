      "id": "a0",
      "pos": 1,
      "text": "Scholars contrast diffusion from a single source with independent invention when explaining a trait shared by two distant societies.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Kulturkreis diffusionists traced most cultural traits to a small number of originating centers.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Unilineal evolutionists held that societies pass through similar stages and invent similar traits independently.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Franz Boas rejected diffusion and explained cultural similarities solely by independent invention.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "A diffusion hypothesis requires a demonstrable route of contact between the two societies.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The absence of a trait in intervening regions weakens a diffusion claim.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The age-area hypothesis holds that the region where a trait appears most recently is its center of origin.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Convergent functional constraints can produce similar technologies in societies that never met.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Shared arbitrary details carry more evidential weight for common origin than shared functional features.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Loanwords accompanying a practice support its transmission from one society to the other.",
      "factual": true,
      "stance": "asserted"
