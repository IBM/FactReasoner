  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "A worker sustained a crush injury to the hand during a collaborative operation with the robot.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The collaborative robot was installed on the plant's assembly line by a third-party system integrator.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The manufacturer attributed the injury to the integrator's configuration of the safety parameters.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The plant operator attributed the injury to a defect in the robot's force-limiting sensors.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "ISO 10218-2 assigns sole responsibility for safety parameter configuration to the robot manufacturer.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "ISO/TS 15066 specifies biomechanical force and pressure limits for collaborative robot applications.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "ISO/TS 15066 prohibits any physical contact between a collaborative robot and a human worker.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Investigators measured the robot's contact forces using an instrumented force and pressure measurement device.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The measured contact force exceeded the ISO/TS 15066 limit for the hand region.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The measured peak contact force was twice the permissible limit for the hand.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The contact force recorded during the incident was 200 percent of the allowable hand force value.",
      "factual": true,
      "stance": "asserted"
