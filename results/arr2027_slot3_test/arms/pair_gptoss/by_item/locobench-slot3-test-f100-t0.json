    {
      "id": "a0",
      "pos": 1,
      "text": "Robert Sampson's Project on Human Development in Chicago Neighborhoods measured collective efficacy across Chicago neighborhoods.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Higher collective efficacy was associated with lower rates of neighborhood violence.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Patrick Sharkey documented multigenerational exposure to high-poverty neighborhoods among Black American families.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Observational neighborhood studies are vulnerable to omitted variable bias from unmeasured parental traits.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Wodtke, Harding, and Elwert applied marginal structural models with inverse probability weighting to address time-varying confounding of neighborhood exposure.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Sibling fixed-effects designs compare siblings whose childhoods were spent in neighborhoods of differing quality.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Sibling fixed-effects designs remove all unobserved confounding, including factors that change over time within a family.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Gautreaux program relocated Chicago public housing residents under a court-ordered desegregation remedy.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The Moving to Opportunity demonstration randomly assigned housing voucher offers to low-income families in five U.S. cities.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Researchers used the randomized voucher offer as an instrument for subsequent exposure to neighborhood poverty.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Chetty, Hendren, and Katz found that children who moved to lower-poverty neighborhoods before age 13 earned more as adults.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Moving to Opportunity recruited families in all fifty states through a national lottery.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Moving to Opportunity included a randomly assigned control group that received no new housing voucher.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Every family enrolled in Moving to Opportunity received an experimental housing voucher.",
      "factual": true,
      "stance": "asserted"
    }
