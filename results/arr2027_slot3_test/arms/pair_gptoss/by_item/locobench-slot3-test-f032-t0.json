    {
      "id": "a0",
      "pos": 1,
      "text": "Cognitivism holds that moral judgments express beliefs.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Non-cognitivism holds that moral judgments express desire-like attitudes such as approval or disapproval.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Non-cognitivism denies that moral statements possess truth values.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
