      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Mackie denied the existence of objective moral values.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Mackie affirmed the existence of objective moral values.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Mackie's error theory classifies moral judgments as non-cognitive expressions of emotion.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Peter Geach pressed the embedding problem against non-cognitivist semantics for moral terms.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The Frege\u2013Geach problem concerns the behaviour of moral terms in unasserted contexts such as the antecedents of conditionals.",
