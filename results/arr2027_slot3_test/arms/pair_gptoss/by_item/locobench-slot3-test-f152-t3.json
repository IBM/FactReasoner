      "text": "Pandemic-era fiscal transfers raised household demand for goods.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The Federal Reserve Bank of New York publishes the Global Supply Chain Pressure Index.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The Global Supply Chain Pressure Index reached its record high in December 2021.",
      "factual": true,
      "stance": "asserted"
    },
