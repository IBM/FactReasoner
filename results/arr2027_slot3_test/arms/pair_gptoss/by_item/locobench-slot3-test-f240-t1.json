    {
      "id": "a5",
      "pos": 6,
      "text": "At least half of the Reproducibility Project: Psychology replications reached statistical significance.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Gilbert and colleagues argued in 2016 that low-fidelity protocols explained the Reproducibility Project's low replication rate.",
