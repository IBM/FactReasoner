    {
      "id": "a0",
      "pos": 1,
      "text": "Manuel Elizalde Jr. headed PANAMIN, the Philippine government body for national minorities, at the time the Tasaday were publicized.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "A local hunter and trapper named Dafal encountered the Tasaday before Elizalde's first visit.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The Tasaday were first contacted in 1963 in the mountains of northern Luzon.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "National Geographic published a feature article on the Tasaday in 1972.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Press and television coverage of the Tasaday overstated their degree of isolation from neighboring communities.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The Tasaday area was closed to outside researchers and journalists from the mid-1970s until 1986.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Swiss journalist Oswald Iten visited the Tasaday in 1986 and reported finding them living in houses and wearing manufactured clothing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Iten's published report asserted that the Tasaday had been instructed to pose as cave dwellers in exchange for goods.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Manuel Elizalde Jr. publicly admitted in 1988 that he had hired farmers from nearby villages to impersonate cave dwellers.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Anthropologist Gerald Berreman publicly argued that the Tasaday had been staged for the benefit of outsiders.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The Tasaday were coached by outsiders to present themselves as cave dwellers to visiting journalists.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Linguist Lawrence Reid concluded that Tasaday speech was a Manobo variety that had diverged from neighboring dialects roughly 150 years earlier.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The Tasaday were not a fabrication assembled by outsiders.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The Tasaday community existed independently of any staged deception.",
      "factual": true,
      "stance": "asserted"
    }
