  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Georg Ernst Stahl formulated the phlogiston theory in the early eighteenth century.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Phlogiston theory held that a burning body released a material substance called phlogiston into the air.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Jean Rey argued in 1630 that calcined tin gained weight by taking up matter from the air.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Lavoisier heated tin in a hermetically sealed glass retort.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The sealed retort showed no change in total mass after the metal had been calcined inside it.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Lavoisier stated the principle that the total mass of matter is conserved in a chemical change.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Air rushed into the vessel when Lavoisier broke the seal of the retort after heating.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The weight gained by the metal equalled the weight of air lost from the sealed vessel.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Lavoisier's calcination trials were carried out in open crucibles standing in the free atmosphere.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Joseph Priestley obtained a new gas in 1774 by heating mercuric oxide with a burning lens.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Priestley called the gas he obtained from mercuric oxide dephlogisticated air.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Henry Cavendish discovered oxygen in 1766 by heating red calx of mercury.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Phlogiston theory was ultimately retained as the accepted account of combustion.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Phlogiston theory was ultimately abandoned in favour of the oxygen theory of combustion.",
      "factual": true,
      "stance": "asserted"
    }
