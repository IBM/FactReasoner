  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Stoet and Geary published the gender-equality paradox finding in Psychological Science in 2018.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "In more gender-egalitarian countries, women make up a smaller share of STEM graduates.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Higher national gender equality is associated with a lower proportion of women among recipients of STEM degrees.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Richardson and colleagues reported in 2020 that the propensity measure behind the paradox could not be reproduced from its published description.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Psychological Science issued a corrigendum determining that the propensity measure used in the original article differed from the measure described in its text.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The propensity measure in the Stoet and Geary article was computed exactly as the published text described.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Su, Rounds, and Armstrong's 2009 meta-analysis found a large average sex difference on the things\u2013people dimension of vocational interests.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Women receive about one-fifth of U.S. bachelor's degrees in engineering.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Women's share of U.S. bachelor's degrees in computer science fell from roughly 37 percent in the mid-1980s to under 20 percent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Girls outscore boys in mathematics in every OECD member country.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Socialization shapes the occupational interests that adolescents express.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Structural barriers reduce women's persistence in STEM fields.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The 2018 National Academies report documented widespread sexual harassment of women in academic science.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The National Academies consensus study committee concluded that sexual harassment is a significant driver of women's departure from academic science careers.",
      "factual": true,
      "stance": "asserted"
    }
