      "pos": 1,
      "text": "Abraham Bredius authenticated \"The Supper at Emmaus\" as a work by Johannes Vermeer.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Museum Boijmans Van Beuningen in Rotterdam purchased \"The Supper at Emmaus\".",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Provenance research traces the documented ownership history of a painting.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Radiocarbon dating establishes the year of a painting's execution to within a single year.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Paul Coremans led the laboratory examination of the disputed Vermeers.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Phenol-formaldehyde resin was identified in the paint layers of the disputed pictures.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Van Meegeren stood trial in Amsterdam in 1947.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Van Meegeren received a sentence of one year in prison.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Phenol-formaldehyde resin was first manufactured in the twentieth century.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Synthetic ultramarine became commercially available in the seventeenth century.",
      "factual": false,
      "stance": "asserted"
