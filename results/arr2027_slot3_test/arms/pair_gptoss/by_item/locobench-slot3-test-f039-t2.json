  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The LIGO Hanford and LIGO Livingston detectors both registered the GW170817 signal.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The gravitational-wave waveform matched the inspiral of two compact objects with masses consistent with neutron stars.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Fermi's Gamma-ray Burst Monitor independently triggered on a short gamma-ray burst designated GRB 170817A.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The gamma-ray burst arrived 1.7 seconds after the gravitational-wave merger time.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The measured delay between the gravitational-wave and gamma-ray arrivals constrained the speed of gravity to within a few parts in 10^15 of the speed of light.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The Fermi-GBM localization region for GRB 170817A overlapped the gravitational-wave sky map.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The joint temporal and spatial analysis yielded a chance coincidence probability of 5 x 10^-8.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The joint analysis of the gamma-ray and gravitational-wave data gave a chance coincidence probability of about one in one thousand.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The Swope telescope identified the optical transient SSS17a in NGC 4993 about 11 hours after the merger.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The optical counterpart of GW170817 was first identified by the Hubble Space Telescope.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The host galaxy NGC 4993 lies about 40 megaparsecs from Earth.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "NGC 4993 is located roughly 130 million light-years away.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "The gamma-ray emission of GRB 170817A was produced by a relativistic jet viewed off its axis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The gamma-ray emission of GRB 170817A was produced by a shock breaking out of a mildly relativistic cocoon.",
      "factual": true,
      "stance": "asserted"
    }
  ],
