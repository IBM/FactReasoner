  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Jackson v. Denno requires a trial judge to make a reliable determination of voluntariness outside the presence of the jury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The trial judge resolves irreconcilable testimony by assessing the demeanor and consistency of the competing witnesses.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Jackson v. Denno held that the jury alone decides in the first instance whether a confession was voluntary.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The prosecution bears the burden of proving that a contested confession was voluntary.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Lego v. Twomey established that the federal constitutional minimum for proving voluntariness is a preponderance of the evidence.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Lego v. Twomey required the prosecution to prove voluntariness beyond a reasonable doubt in every court in the United States.",
      "factual": false,
      "stance": "asserted"
    },
    {
