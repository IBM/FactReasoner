  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The thylacine was a marsupial carnivore endemic to Tasmania at the time of European colonisation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Thylacines disappeared from mainland Australia approximately 3,000 years ago.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Genomic sequencing of thylacine specimens revealed low genetic diversity predating European arrival.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The Van Diemen's Land Company offered private bounties on thylacines from the 1830s.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The Tasmanian parliament introduced a government bounty on thylacines in 1888.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The government bounty scheme paid out 2,184 claims before it was discontinued in 1909.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The Tasmanian bounty scheme paid out more than 15,000 claims.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Thylacine habitat in the Tasmanian Midlands was converted to sheep pasture.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Prey availability for thylacines declined across settled districts of Tasmania.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "A distemper-like disease was reported among Tasmanian carnivores in the early twentieth century.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Researchers compiled bounty payments, museum accessions and sighting reports into a dated records database.",
      "factual": true,
      "stance": "asserted"
    },
    {
