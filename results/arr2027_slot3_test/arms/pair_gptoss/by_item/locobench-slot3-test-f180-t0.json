      "pos": 13,
      "text": "The 2013 modelling study concluded that an introduced disease epidemic was the necessary primary driver of the extinction.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The published assessment of the competing hypotheses determined that disease was not a necessary component of the extinction and identified bounty-driven hunting as the dominant cause.",
      "factual": true,
      "stance": "asserted"
