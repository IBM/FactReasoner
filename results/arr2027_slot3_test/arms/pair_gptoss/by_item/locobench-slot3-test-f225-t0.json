  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Google announced a quantum supremacy result using its Sycamore processor in October 2019.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Sycamore processor used 53 superconducting qubits for the random circuit sampling task.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Google reported that the random circuit sampling task took about 200 seconds on Sycamore.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Google estimated that the same sampling task would require about 10,000 years on the Summit supercomputer.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "IBM responded that the Sycamore task could be completed classically in about 2.5 days using secondary storage on Summit.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "IBM's rebuttal stated that Summit could finish the Sycamore sampling task in 11 minutes.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Pan, Chen and Zhang reported a tensor-network classical simulation of the Sycamore sampling task on a GPU cluster.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A later benchmarking review concluded that the 10,000-year classical runtime estimate no longer held for the Sycamore task.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Linear cross-entropy benchmarking is the fidelity measure used to verify random circuit sampling experiments.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Classical spoofing algorithms have achieved cross-entropy benchmarking scores comparable to those of the quantum hardware.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Ewin Tang published a classical algorithm for the recommendation systems problem in 2018.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The exponential advantage of the quantum recommendation system over classical methods disappeared after Tang's result.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Credible advantage claims require benchmarking the quantum runtime against the best known classical algorithm rather than a naive simulation method.",
      "factual": true,
      "stance": "asserted"
    }
  ],
