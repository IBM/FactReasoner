  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Chance resemblance is one of the explanations investigators must exclude before positing descent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The comparative method establishes genetic relationship through systematic sound correspondences across many lexical items.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Basic vocabulary such as numerals and kinship terms is comparatively resistant to borrowing.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Shared irregularities in inflectional paradigms are treated as strong evidence of common descent.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "A shared typological profile is by itself sufficient proof of genetic relatedness.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Grammatical features are never transferred between languages in situations of contact.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Grammatical patterns can be transferred between languages through prolonged bilingualism.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "A Sprachbund is a geographic zone in which neighbouring languages converge on shared structural features.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Geographic contiguity of the languages sharing a feature supports a contact explanation.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Balkan languages from different Indo-European branches share a postposed definite article.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The postposed definite article of the Balkan languages is reconstructed for Proto-Indo-European.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Retroflex consonants in Indo-Aryan languages have been attributed to a Dravidian substrate.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Thomason and Kaufman set out explicit criteria for establishing contact-induced change.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Documented historical evidence of bilingual communities strengthens a contact hypothesis.",
      "factual": true,
      "stance": "asserted"
    }
  ],
