  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The Great Debate was held on 26 April 1920 at the Smithsonian Museum of Natural History in Washington, D.C.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Harlow Shapley argued that the spiral nebulae were gaseous clouds lying inside a single large Milky Way system.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Heber Curtis argued that the spiral nebulae were distant stellar systems comparable in size to the Milky Way.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Curtis cited novae observed in spiral nebulae as evidence that those nebulae lay at great distances.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Curtis's analysis of novae in spiral nebulae placed M31 about 10,000 light years from the Sun.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "S Andromedae, which appeared in 1885, was a supernova far more luminous than an ordinary nova.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Shapley relied on Adriaan van Maanen's reported measurements of internal rotation in spiral nebulae.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Van Maanen's measurements of rotation in spiral nebulae were confirmed by later photographic plate comparisons.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "A later reexamination of van Maanen's plates concluded that the reported rotations of spiral nebulae were measurement artifacts.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Henrietta Leavitt established the period-luminosity relation from Cepheid variables in the Magellanic Clouds.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Edwin Hubble identified Cepheid variable stars in M31 using the 100-inch Hooker telescope at Mount Wilson.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Hubble derived a distance to M31 of roughly 900,000 light years.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "M31 lies outside the boundaries of the Milky Way system.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "M31 lies within the boundaries of the Milky Way system.",
      "factual": true,
      "stance": "asserted"
    }
