    {
      "id": "a9",
      "text": "The break happened at or near the time of death, before the bone's collagen degraded.",
      "label": "p10",
      "factual": true,
      "role": "claim",
      "pos": 10
    },
    {
      "id": "a10",
      "text": "Every fracture margin on the skeleton was produced after death.",
