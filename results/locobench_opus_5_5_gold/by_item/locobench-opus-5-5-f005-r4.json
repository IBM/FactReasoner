  "atoms": [
    {
      "id": "a0",
      "text": "Urbain Le Verrier predicted the position of Neptune from irregularities in the orbit of Uranus.",
      "label": "p1",
      "factual": true,
      "role": "claim",
      "pos": 1
    },
    {
      "id": "a1",
      "text": "Johann Galle first observed Neptune in 1848.",
      "label": "p2",
      "factual": false,
      "role": "claim",
      "pos": 2
    },
    {
      "id": "a2",
      "text": "Le Verrier reported an unexplained excess in the precession of Mercury's perihelion in 1859.",
      "label": "p3",
      "factual": true,
      "role": "claim",
      "pos": 3
    },
    {
      "id": "a3",
      "text": "Le Verrier proposed that an undiscovered planet orbiting inside Mercury's orbit caused the anomaly.",
      "label": "p4",
      "factual": true,
      "role": "claim",
      "pos": 4
    },
    {
      "id": "a4",
      "text": "The hypothetical planet inside Mercury's orbit was given the name Vulcan.",
      "label": "p5",
      "factual": true,
      "role": "claim",
      "pos": 5
    },
    {
      "id": "a5",
      "text": "The amateur astronomer Edmond Lescarbault claimed to have seen an unknown body transit the Sun in 1859.",
      "label": "p6",
      "factual": true,
      "role": "claim",
      "pos": 6
    },
    {
      "id": "a6",
      "text": "A planet inside Mercury's orbit massive enough to account for the perihelion anomaly exists.",
      "label": "p7",
      "factual": true,
      "role": "claim",
      "pos": 7,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a7",
      "text": "No planet inside Mercury's orbit massive enough to account for the perihelion anomaly exists.",
      "label": "p8",
      "factual": true,
      "role": "claim",
      "pos": 8,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a8",
      "text": "Charles Dillon Perrine's photographic searches at early twentieth-century eclipses found no intra-Mercurial planet.",
      "label": "p9",
      "factual": true,
      "role": "claim",
      "pos": 9
    },
    {
      "id": "a9",
      "text": "The astronomical community ultimately concluded that the planet Vulcan does not exist.",
      "label": "p10",
      "factual": true,
      "role": "claim",
      "pos": 10
    },
    {
      "id": "a10",
      "text": "Unseen matter near the Sun perturbs Mercury's orbit beyond the effects of the known planets.",
      "label": "p11",
      "factual": true,
      "role": "claim",
      "pos": 11
    },
    {
      "id": "a11",
      "text": "Newtonian gravity departs from the true law of gravitation in the strong solar field near Mercury.",
      "label": "p12",
      "factual": true,
      "role": "claim",
      "pos": 12
    },
    {
      "id": "a12",
      "text": "Einstein's general relativity predicted an excess perihelion advance for Mercury of about 75 arcseconds per century.",
      "label": "p13",
      "factual": false,
      "role": "claim",
      "pos": 13
    },
    {
      "id": "a13",
      "text": "General relativity accounts for about 43 arcseconds per century of Mercury's perihelion advance.",
      "label": "p14",
      "factual": true,
      "role": "claim",
      "pos": 14
    },
    {
      "id": "a14",
      "text": "Einstein's theory of gravitation explains roughly 43 seconds of arc per century of extra precession in Mercury's perihelion.",
      "label": "p15",
      "factual": true,
      "role": "claim",
      "pos": 15
    },
    {
      "id": "a15",
      "text": "Astronomers ultimately determined that Mercury's anomalous precession arose from a flaw in Newtonian gravity rather than from an unseen planet.",
      "label": "p16",
      "factual": true,
      "role": "claim",
      "pos": 16
