  "atoms": [
    {
      "id": "a0",
      "text": "Violent crime in the United States fell substantially between 1991 and 2000.",
      "label": "p1",
      "factual": true,
      "role": "claim",
      "pos": 1
    },
    {
      "id": "a1",
      "text": "The US violent crime rate in 2000 was substantially lower than the rate in 1991.",
      "label": "p2",
      "factual": true,
      "role": "claim",
      "pos": 2
    },
    {
      "id": "a2",
      "text": "Steven Levitt published \"Understanding Why Crime Fell in the 1990s\" in the Journal of Economic Perspectives in 2004.",
      "label": "p3",
      "factual": true,
      "role": "claim",
      "pos": 3
    },
    {
      "id": "a3",
      "text": "Levitt identified increased police numbers as one of four main factors behind the 1990s crime decline.",
      "label": "p4",
      "factual": true,
      "role": "claim",
      "pos": 4
    },
    {
      "id": "a4",
      "text": "The 1994 federal crime bill funded the hiring of additional police officers.",
      "label": "p5",
      "factual": true,
      "role": "claim",
      "pos": 5,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
