    {
      "id": "a6",
      "text": "Levitt estimated that rising incarceration accounted for roughly one third of the 1990s crime decline.",
      "label": "p7",
      "factual": true,
      "role": "claim",
      "pos": 7
    },
    {
      "id": "a7",
      "text": "A 2015 Brennan Center report estimated that increased incarceration accounted for a minor share of the 1990s crime decline.",
      "label": "p8",
      "factual": true,
      "role": "claim",
      "pos": 8
    },
    {
      "id": "a8",
      "text": "The National Research Council committee concluded that the growth in incarceration had a modest crime-reducing effect subject to diminishing returns.",
      "label": "p9",
      "factual": true,
      "role": "claim",
      "pos": 9
    },
    {
      "id": "a9",
      "text": "Increased incarceration reduced crime in the United States during the 1990s.",
      "label": "p10",
      "factual": true,
      "role": "claim",
      "pos": 10
    },
    {
      "id": "a10",
      "text": "The waning of the crack cocaine market reduced crime in the United States during the 1990s.",
      "label": "p11",
      "factual": true,
      "role": "claim",
      "pos": 11
    },
    {
      "id": "a11",
      "text": "Levitt concluded that the strong 1990s economy was one of the four main factors behind the crime decline.",
