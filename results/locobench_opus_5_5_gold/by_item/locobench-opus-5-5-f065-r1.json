  "atoms": [
    {
      "id": "a0",
      "text": "The BICEP2 collaboration announced its detection of B-mode polarization on March 17, 2014.",
      "label": "p1",
      "factual": true,
      "role": "claim",
      "pos": 1
    },
    {
      "id": "a1",
      "text": "The BICEP2 telescope was located in Chile's Atacama Desert.",
      "label": "p2",
      "factual": false,
      "role": "claim",
      "pos": 2
    },
    {
      "id": "a2",
      "text": "BICEP2 reported a tensor-to-scalar ratio of r = 0.20.",
      "label": "p3",
      "factual": true,
      "role": "claim",
      "pos": 3
    },
    {
      "id": "a3",
      "text": "The BICEP2 team interpreted the signal as evidence of primordial gravitational waves from cosmic inflation.",
      "label": "p4",
      "factual": true,
      "role": "claim",
      "pos": 4
    },
    {
      "id": "a4",
      "text": "The Planck collaboration released dust polarization measurements at 353 GHz in September 2014.",
      "label": "p5",
      "factual": true,
      "role": "claim",
      "pos": 5
    },
    {
      "id": "a5",
      "text": "The Planck 353 GHz data indicated that dust in the BICEP2 field was brighter than BICEP2 had assumed.",
      "label": "p6",
      "factual": true,
      "role": "claim",
      "pos": 6
    },
    {
      "id": "a6",
      "text": "The BICEP2, Keck Array, and Planck teams performed a joint cross-correlation analysis of their data.",
      "label": "p7",
      "factual": true,
      "role": "claim",
      "pos": 7
    },
    {
      "id": "a7",
      "text": "The joint analysis confirmed a gravitational-wave detection at more than five sigma significance.",
      "label": "p8",
      "factual": false,
      "role": "claim",
      "pos": 8
    },
    {
      "id": "a8",
      "text": "Polarized Galactic dust emission contributed B-mode power in the BICEP2 observing field.",
      "label": "p9",
      "factual": true,
      "role": "claim",
      "pos": 9
    },
    {
      "id": "a9",
      "text": "Gravitational lensing of E-mode polarization contributed B-mode power in the BICEP2 observing field.",
      "label": "p10",
      "factual": true,
      "role": "claim",
      "pos": 10
    },
    {
      "id": "a10",
      "text": "The BICEP2 B-mode signal was produced primarily by primordial gravitational waves.",
      "label": "p11",
      "factual": true,
      "role": "claim",
      "pos": 11,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a11",
      "text": "The BICEP2 B-mode signal was not produced primarily by primordial gravitational waves.",
      "label": "p12",
      "factual": true,
      "role": "claim",
      "pos": 12,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a12",
      "text": "The joint analysis set an upper limit on the tensor-to-scalar ratio of r < 0.12 at 95% confidence.",
      "label": "p13",
      "factual": true,
      "role": "claim",
      "pos": 13
    },
    {
      "id": "a13",
      "text": "The joint analysis excluded tensor-to-scalar ratios of 0.12 or higher at 95% confidence.",
      "label": "p14",
      "factual": true,
      "role": "claim",
      "pos": 14
    },
    {
      "id": "a14",
      "text": "The joint BICEP2/Keck/Planck analysis concluded that no statistically significant evidence for primordial gravitational waves remained once dust was accounted for.",
