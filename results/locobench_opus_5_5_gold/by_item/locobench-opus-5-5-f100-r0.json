      "id": "a0",
      "text": "Bertrand Russell wrote a letter to Gottlob Frege in June 1902.",
      "label": "p1",
      "factual": true,
      "role": "claim",
      "pos": 1
    },
    {
      "id": "a1",
      "text": "Russell's letter to Frege was dated 1905.",
      "label": "p2",
      "factual": false,
      "role": "claim",
      "pos": 2
    },
    {
      "id": "a2",
      "text": "Russell's letter described a contradiction derivable within Frege's logical system.",
      "label": "p3",
      "factual": true,
      "role": "claim",
      "pos": 3
    },
    {
      "id": "a3",
      "text": "The contradiction concerns the class of all classes that are not members of themselves.",
      "label": "p4",
      "factual": true,
      "role": "claim",
      "pos": 4
    },
    {
      "id": "a4",
      "text": "Frege received Russell's letter before the second volume of the Grundgesetze was published.",
      "label": "p5",
      "factual": true,
      "role": "claim",
      "pos": 5,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
