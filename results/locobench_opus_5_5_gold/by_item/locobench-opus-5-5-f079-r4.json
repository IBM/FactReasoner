      "role": "claim",
      "pos": 8
    },
    {
      "id": "a8",
      "text": "The oxygen evolved in the 1941 experiment matched the isotopic composition of the water supplied.",
      "label": "p9",
      "factual": true,
      "role": "claim",
      "pos": 9,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
