  "atoms": [
    {
      "id": "a0",
      "text": "The USS Maine exploded and sank in Havana harbor on February 15, 1898.",
      "label": "p1",
      "factual": true,
      "role": "claim",
      "pos": 1
    },
    {
      "id": "a1",
      "text": "The U.S. Navy convened a court of inquiry headed by Captain William T. Sampson in 1898.",
      "label": "p2",
      "factual": true,
      "role": "claim",
      "pos": 2
    },
    {
      "id": "a2",
      "text": "The 1898 court of inquiry was presided over by Admiral George Dewey.",
      "label": "p3",
      "factual": false,
      "role": "claim",
      "pos": 3
    },
    {
      "id": "a3",
      "text": "Divers reported that a section of the Maine's keel near frame 18 was bent into an inverted V shape.",
      "label": "p4",
      "factual": true,
      "role": "claim",
      "pos": 4
    },
    {
      "id": "a4",
      "text": "The Sampson court of inquiry concluded that a submarine mine had set off the Maine's forward magazines.",
      "label": "p5",
      "factual": true,
      "role": "claim",
      "pos": 5
    },
    {
      "id": "a5",
      "text": "The United States declared war on Spain in April 1898.",
      "label": "p6",
      "factual": true,
      "role": "claim",
      "pos": 6
    },
    {
      "id": "a6",
      "text": "The Maine's coal bunkers lay adjacent to its forward magazines.",
      "label": "p7",
      "factual": true,
      "role": "claim",
      "pos": 7
    },
    {
      "id": "a7",
      "text": "A spontaneous fire was burning in a coal bunker beside the Maine's forward magazine.",
      "label": "p8",
      "factual": true,
      "role": "claim",
      "pos": 8
    },
    {
      "id": "a8",
      "text": "A mine detonated against the Maine's hull below the forward magazines.",
      "label": "p9",
      "factual": true,
      "role": "claim",
      "pos": 9
    },
    {
      "id": "a9",
      "text": "The explosion that destroyed the Maine originated outside the ship's hull.",
      "label": "p10",
      "factual": true,
      "role": "claim",
      "pos": 10,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a10",
      "text": "The explosion that destroyed the Maine originated inside the ship's hull.",
      "label": "p11",
      "factual": true,
      "role": "claim",
      "pos": 11,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a11",
      "text": "The Rickover study was published in 1958.",
      "label": "p12",
      "factual": false,
      "role": "claim",
      "pos": 12
    },
    {
      "id": "a12",
      "text": "The Rickover study concluded that the damage was most consistent with an internal coal-bunker fire igniting a magazine.",
      "label": "p13",
      "factual": true,
      "role": "claim",
      "pos": 13
    },
    {
      "id": "a13",
      "text": "Most historians now attribute the sinking of the Maine to an internal explosion.",
