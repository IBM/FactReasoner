  "atoms": [
    {
      "id": "a0",
      "text": "Nikolai Fedyakin first reported anomalous water condensed in narrow glass capillaries in 1962.",
      "label": "p1",
      "factual": true,
      "role": "claim",
      "pos": 1
    },
    {
      "id": "a1",
      "text": "Fedyakin conducted his early anomalous water experiments in Leningrad.",
      "label": "p2",
      "factual": false,
      "role": "claim",
      "pos": 2
    },
    {
      "id": "a2",
      "text": "The anomalous water was produced by condensing water vapor in fine quartz or glass capillaries.",
      "label": "p3",
      "factual": true,
      "role": "claim",
      "pos": 3
    },
    {
      "id": "a3",
      "text": "Boris Deryagin of the Institute of Physical Chemistry in Moscow took up and publicized the anomalous water research.",
      "label": "p4",
      "factual": true,
      "role": "claim",
      "pos": 4
    },
    {
      "id": "a4",
      "text": "Anomalous water froze at a lower temperature than ordinary water.",
      "label": "p5",
      "factual": true,
      "role": "claim",
      "pos": 5
    },
    {
      "id": "a5",
      "text": "Ordinary water froze at a higher temperature than anomalous water.",
      "label": "p6",
      "factual": true,
      "role": "claim",
      "pos": 6
    },
    {
      "id": "a6",
      "text": "Ellis Lippincott and colleagues published infrared spectra of anomalous water in Science in 1969.",
      "label": "p7",
      "factual": true,
      "role": "claim",
      "pos": 7
    },
    {
      "id": "a7",
      "text": "Ellis Lippincott was a chemist at Harvard University.",
      "label": "p8",
      "factual": false,
      "role": "claim",
      "pos": 8
    },
    {
      "id": "a8",
      "text": "Lippincott's group proposed that anomalous water was a polymer of water molecules.",
      "label": "p9",
      "factual": true,
      "role": "claim",
      "pos": 9
    },
    {
      "id": "a9",
      "text": "Rousseau obtained an infrared spectrum resembling polywater from his own sweat.",
      "label": "p10",
      "factual": true,
      "role": "claim",
      "pos": 10
    },
    {
      "id": "a10",
      "text": "The polywater samples contained silica dissolved from the walls of the capillaries.",
      "label": "p11",
      "factual": true,
      "role": "claim",
      "pos": 11
    },
    {
      "id": "a11",
      "text": "The polywater samples contained organic contaminants such as lactate from human sweat.",
      "label": "p12",
      "factual": true,
      "role": "claim",
      "pos": 12
    },
    {
      "id": "a12",
      "text": "Deryagin publicly retracted his claim that anomalous water was a new form of water.",
      "label": "p13",
      "factual": true,
      "role": "claim",
      "pos": 13,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a13",
      "text": "Deryagin never retracted his claim that anomalous water was a new form of water.",
      "label": "p14",
      "factual": true,
      "role": "claim",
      "pos": 14,
      "factual_note": "exhaustive_pair: exactly one of this pair is false"
    },
    {
      "id": "a14",
      "text": "Deryagin and Churaev concluded in a 1973 Nature report that the anomalous properties were caused by impurities.",
