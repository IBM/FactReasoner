      "role": "claim",
      "pos": 2
    },
    {
      "id": "a2",
      "text": "Hagger and colleagues published a 2010 meta-analysis that reported a medium-sized ego-depletion effect.",
      "label": "p3",
      "factual": true,
      "role": "claim",
      "pos": 3
    },
    {
      "id": "a3",
      "text": "The 2010 Hagger meta-analysis estimated the ego-depletion effect at roughly d = 0.62.",
