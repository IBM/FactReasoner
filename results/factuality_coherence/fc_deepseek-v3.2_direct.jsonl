{"item_id": "bio-0001", "dataset": "bio", "input": "Question: Tell me a bio of Marianne McAndrew.", "output": "Marianne McAndrew is an American actress and singer, born on November 21, 1942, in Cleveland, Ohio. She began her acting career in the late 1960s, appearing in various television shows and films. Her notable film appearances include the role of Irene Molloy in the 1969 film adaptation of the musical \"Hello, Dolly!\", and as Princess Zareta in the 1976 film \"The Blue Bird\". She also had recurring roles on popular television shows such as \"The Love Boat\" and \"Fantasy Island\". In addition to her acting career, McAndrew was a trained singer and performed in various stage productions, including the Broadway production of \"The King and I\". She retired from acting in the 1990s and currently resides in California.", "topic": "Marianne McAndrew", "model": "deepseek-v3.2", "nli_method": "direct", "num_atoms": 20, "num_contexts": 57, "gold_atom_labels": ["NS", "S", "NS", "NS", "NS", "S", "S", "S", "S", "S", "S", "S", "NS", "NS", "S", "NS", "NS", "NS", "NS", "NS"], "lcs_windowed": {"scores": {"mean_marginal": 0.86605145, "consistency": 0.9808635139079671, "reified": 0.498667, "log_partition": 1.0}, "headline": 0.86605145, "method": "mean_marginal", "marginals": {"a0": 0.598786, "a1": 0.999447, "a10": 1.0, "a11": 1.0, "a12": 0.99999, "a13": 0.999583, "a14": 1.0, "a15": 0.665894, "a16": 0.997944, "a17": 0.999987, "a18": 0.5, "a19": 0.5, "a2": 0.666394, "a3": 0.5, "a4": 0.898174, "a5": 0.994852, "a6": 0.99998, "a7": 0.999998, "a8": 1.0, "a9": 1.0}, "diagnostics": {"num_atoms": 20, "num_below_prior": 0, "avg_norm_entropy": 0.31823809246088997, "log_z": -5.267596, "log_z_max": -5.267596, "log_z_min": -8.277718}, "num_relations": 29, "mining_coverage": {"policy": "windowed", "num_atoms": 20, "total_ordered_pairs": 380, "window": 4, "gate": null, "gate_backend": null, "gate_threshold": null, "num_window_pairs": 70, "num_callback_pairs": 0, "pairs_selected": 173, "for