{"item_id": "bio-0002", "dataset": "bio", "input": "Question: Tell me a bio of Doug Sheehan.", "output": "Doug Sheehan is an American actor who was born on April 27, 1949, in Santa Monica, California. He is best known for his roles in soap operas, including his portrayal of Joe Kelly on \"General Hospital\" and Ben Gibson on \"Knots Landing.\" Sheehan began his acting career in the 1970s and appeared in several popular TV shows such as \"The Rockford Files\" and \"M*A*S*H.\" In addition to his work on television, Sheehan has appeared in films such as \"Cocoon: The Return\" and \"Clambake.\" In recent years, he has focused on directing and producing theater productions in his local community. Sheehan has been married twice and has two children.", "topic": "Doug Sheehan", "model": "deepseek-v3.2", "nli_method": "direct", "num_atoms": 24, "num_contexts": 65, "gold_atom_labels": ["S", "S", "S", "NS", "S", "S", "S", "S", "S", "S", "S", "S", "S", "S", "NS", "NS", "S", "NS", "NS", "NS", "NS", "NS", "NS", "NS"], "lcs_windowed": {"scores": {"mean_marginal": 0.8736246666666667, "consistency": 0.9998848496608971, "reified": 0.499976, "log_partition": 1.0}, "headline": 0.8736246666666667, "method": "mean_marginal", "marginals": {"a0": 0.984538, "a1": 0.999983, "a10": 1.0, "a11": 1.0, "a12": 0.999912, "a13": 1.0, "a14": 1.0, "a15": 1.0, "a16": 0.999998, "a17": 1.0, "a18": 0.999994, "a19": 0.5, "a2": 0.984483, "a20": 0.5, "a21": 0.5, "a22": 0.5, "a23": 0.5, "a3": 0.5, "a4": 0.998085, "a5": 1.0, "a6": 1.0, "a7": 0.999999, "a8": 1.0, "a9": 1.0}, "diagnostics": {"num_atoms": 24, "num_below_prior": 1, "avg_norm_entropy": 0.26051830496221456, "log_z": -3.575724, "log_z_max": -3.575724, "log_z_min": -7.76786}, "num_relations": 36, "mining_coverage": {"policy": "windowed", "num_atoms": 24, "total_ordered_pairs": 552, "window": 4, "gate": null, "gate_backend": null, "gate_threshold": null, "num_window_pairs": 86, "num_callback_pairs": 0, "pairs_selected": 257, "forward_pairs_possible": 2