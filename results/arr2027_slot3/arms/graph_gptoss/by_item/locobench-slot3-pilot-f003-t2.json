  "notes": null,
  "num_atoms": 14,
  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Urbain Le Verrier announced in 1859 that Mercury's perihelion advanced faster than Newtonian theory predicted.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The unexplained portion of Mercury's perihelion advance amounts to about 43 arcseconds per century.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "The portion of Mercury's perihelion precession left unexplained by planetary perturbations is 574 arcseconds per century.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "Le Verrier had previously inferred the existence and position of Neptune from irregularities in the motion of Uranus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Le Verrier attributed the Mercury anomaly to unseen matter orbiting between Mercury and the Sun.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "The hypothetical intra-Mercurial planet was given the name Vulcan.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Edmond Lescarbault reported seeing a dark object transit the solar disk in 1859.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Le Verrier confirmed Vulcan telescopically in 1860 and published its orbital elements.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "Observers at the 1878 total solar eclipse in North America reported starlike objects close to the Sun.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Later analysis of the 1878 eclipse observations determined that the reported objects were already-catalogued stars.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Repeated eclipse and transit searches produced no reproducible detection of an intra-Mercurial body.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "No intra-Mercurial planet has ever been confirmed to exist.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "A planet named Vulcan orbits the Sun inside the orbit of Mercury.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The value predicted by general relativity agreed with the observed residual without invoking any additional matter.",
      "factual": true,
      "stance": "asserted"
    }
  ],
