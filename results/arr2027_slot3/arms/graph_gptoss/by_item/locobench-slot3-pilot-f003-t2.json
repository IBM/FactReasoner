    "canonical_topic": "Astronomy",
    "domain": "Natural Sciences",
    "framing": "How did astronomers establish whether the anomalous precession of Mercury's perihelion arose from an undiscovered inner planet or from a deficiency in Newtonian gravitation itself?",
    "split": "pilot",
    "word_count": 446,
    "generator": "claude-opus-5",
    "taxonomy": "v2",
