  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "The hominin remains were excavated from Liang Bua cave on the Indonesian island of Flores in 2003.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The Liang Bua fossils were assigned to a newly erected species called Homo floresiensis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Researchers gave the Flores remains a novel species designation, Homo floresiensis.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The endocranial volume of LB1 was estimated at roughly 400 cubic centimetres.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Teuku Jacob argued that LB1 was a microcephalic modern human from a local pygmoid population.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "A 2014 paper attributed LB1's anatomy to Down syndrome.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "The endocranial volume of LB1 was measured at 1,100 cubic centimetres.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Dean Falk's team generated a virtual endocast of LB1 from computed tomography scans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The comparative endocast study published in Science concluded that the brain shape of LB1 differed from that of microcephalic modern humans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The LB1 wrist bones retain a primitive morphology resembling that of early hominins and African apes.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "The Flores hominins retained primitive skeletal traits absent in modern humans.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "The small body size of the Flores hominins arose through evolutionary dwarfing under island conditions.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Hominin fossils with small body size were recovered at the Mata Menge site on Flores in deposits about 700,000 years old.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The Flores hominin population survived on the island until about 12,000 years ago.",
      "factual": false,
      "stance": "asserted"
    }
  ],
