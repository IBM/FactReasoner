    {
      "id": "a0",
      "pos": 1,
      "text": "The excavator argued that the recorded stratigraphy placed the structure later than the dated deposit.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "The dating specialist argued that the calibrated determinations placed construction earlier than the stratigraphy allowed.",
      "factual": true,
      "stance": "asserted"
