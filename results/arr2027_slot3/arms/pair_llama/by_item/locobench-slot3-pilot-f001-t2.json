  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Data contamination occurs when benchmark test items appear in a model's pretraining data.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Researchers test for generalization by evaluating a model on held-out problems absent from its training corpus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Scale AI constructed GSM1k as a freshly written benchmark matched to the distribution of GSM8K.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The model's accuracy on the freshly written benchmark was lower than its accuracy on the original benchmark.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "The model performed better on the original benchmark than on the newly constructed one.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Memorization is conclusively ruled out for any model that scores above ninety percent on a benchmark.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "GSM-Symbolic generates variants of GSM8K items by substituting names and numerical values in templates.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "The GSM-Symbolic study reported that accuracy rose when numerical values in the problems were changed.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The perturbed problem variants were intrinsically harder than the original items.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "The model's answers on the original items depended on surface patterns specific to those items.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Test items from the benchmark appeared verbatim in the model's pretraining corpus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "No test item from the benchmark appeared verbatim in the model's pretraining corpus.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Mechanistic interpretability can identify an internal circuit that implements a specific algorithm inside a trained network.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "Grokking describes a delayed transition during training from memorizing training examples to generalizing to unseen ones.",
      "factual": true,
      "stance": "asserted"
    }
  ],
