  "atoms": [
    {
      "id": "a0",
      "pos": 1,
      "text": "Lynn Margulis published the paper \"On the Origin of Mitosing Cells\" in 1967.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a1",
      "pos": 2,
      "text": "Margulis argued that mitochondria descended from free-living aerobic bacteria taken up by a host cell.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a2",
      "pos": 3,
      "text": "Margulis's 1967 paper proposed that mitochondria arose by invagination of the host plasma membrane.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a3",
      "pos": 4,
      "text": "The autogenous hypothesis held that mitochondria formed by the infolding of the host cell's own membranes.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a4",
      "pos": 5,
      "text": "Margit Nass and Sylvan Nass reported DNA inside mitochondria in 1963 using electron microscopy.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a5",
      "pos": 6,
      "text": "Mitochondria retain a genome of their own that is distinct from the nuclear genome.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a6",
      "pos": 7,
      "text": "Mitochondria contain no DNA of their own.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a7",
      "pos": 8,
      "text": "Mitochondrial ribosomes are inhibited by the antibacterial antibiotic chloramphenicol.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a8",
      "pos": 9,
      "text": "The mitochondrial inner membrane contains cardiolipin, a lipid characteristic of bacterial membranes.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a9",
      "pos": 10,
      "text": "Carl Woese established small-subunit ribosomal RNA sequence comparison as a method for reconstructing deep phylogeny.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a10",
      "pos": 11,
      "text": "Ribosomal RNA phylogenies placed the mitochondrial lineage inside the alphaproteobacteria.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a11",
      "pos": 12,
      "text": "Phylogenetic analyses of mitochondrial genes place the organelle within the cyanobacteria.",
      "factual": false,
      "stance": "asserted"
    },
    {
      "id": "a12",
      "pos": 13,
      "text": "Mitochondria arose from a free-living bacterium that was engulfed by an ancestral host cell.",
      "factual": true,
      "stance": "asserted"
    },
    {
      "id": "a13",
      "pos": 14,
      "text": "The mitochondrial lineage descends from a prokaryotic symbiont that was taken up by an ancestral cell.",
      "factual": true,
      "stance": "asserted"
    }
