<View>
  <Header value="$question" size="5"/>
  <HyperText name="claims" value="$claims_html" inline="true"/>
  <View style="display:flex;gap:1.2em;align-items:flex-start">
    <View style="flex:1;min-width:0">
      <Header value="Version A" size="5"/>
      <HyperText name="a" value="$a_html" inline="true"/>
    </View>
    <View style="flex:1;min-width:0">
      <Header value="Version B" size="5"/>
      <HyperText name="b" value="$b_html" inline="true"/>
    </View>
  </View>
  <HyperText name="ctx" value="$context_html" inline="true"/>
  <Header value="Which version's argument is more logically coherent: do the relations it draws between its claims fit their truth values?" size="5"/>
  <Choices name="preference" toName="a" choice="single-radio" required="true" showInline="true">
    <Choice value="A is more logically coherent"/>
    <Choice value="About equal"/>
    <Choice value="B is more logically coherent"/>
  </Choices>
  <Header value="How sure are you?" size="5"/>
  <Choices name="confidence" toName="a" choice="single-radio" required="true" showInline="true">
    <Choice value="1 (unsure)"/>
    <Choice value="2"/>
    <Choice value="3 (sure)"/>
  </Choices>
</View>
